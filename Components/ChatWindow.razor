@using BlazorReporting.Services
@inject ChatbotService     Chatbot
@inject ChatHistoryService History
@inject SurveyService      Survey
@inject AuthService        Auth
@inject NavMenuService     MenuSvc
@inject LocalizationService L10n
@inject IJSRuntime         JS
@inject NavigationManager  Nav
@implements IDisposable

<div class="cw-root">

    @* ── FAB toggle ── *@
    <button class="cw-fab @(_open ? "cw-fab--open" : "")"
            title="@(_open ? @L10n.T("ai.fab_close") : "AI Assistant")"
            @onclick="ToggleAsync">
        <span class="cw-fab-icon cw-fab-icon--chat"><i class="bi bi-chat-dots-fill"></i></span>
        <span class="cw-fab-icon cw-fab-icon--close"><i class="bi bi-x-lg"></i></span>
    </button>

    @if (_open)
    {
        <div class="cw-window">

            @* ── HEADER ── *@
            <div class="cw-header">
                <div class="cw-header-avatar">
                    <img src="images/dmspro-ai.svg" alt="DMSPro AI" style="width:36px;height:36px;object-fit:contain"/>
                </div>
                <div class="cw-header-info">
                    <div class="cw-header-title">DMSPro AI</div>
                    <div class="cw-header-sub">
                        @if (_loadingModels)
                        {
                            <span class="cw-connecting"><span class="cw-dot-pulse"></span> @L10n.T("ai.connecting")</span>
                        }
                        else if (_models.Count == 0)
                        {
                            <span class="cw-offline">
                                <i class="bi bi-circle-fill" style="font-size:.45rem;color:#f87171"></i> Offline
                            </span>
                        }
                        else
                        {
                            <span class="cw-online">
                                <i class="bi bi-circle-fill" style="font-size:.45rem;color:#4ade80"></i> Online
                            </span>
                        }
                    </div>
                </div>

                @if (_models.Count > 0)
                {
                    <span class="cw-model-select" style="font-size:.7rem;opacity:.7;padding:2px 6px">
                        @ShortName(_selectedModel)
                    </span>
                }

                <div class="cw-header-actions">
                    <button class="cw-icon-btn" title="@L10n.T("ai.clear_history")" @onclick="ClearHistoryAsync">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                    <button class="cw-icon-btn" title="@L10n.T("ai.fab_close")" @onclick="ToggleAsync">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            @* ── BODY ── *@
            <div class="cw-body" id="cw-body">

                @* Empty state *@
                @if (_messages.Count == 0 && !_showSurvey)
                {
                    <div class="cw-empty">
                        <div class="cw-empty-avatar">
                            <img src="images/dmspro-ai.svg" alt="DMSPro AI" style="width:72px;height:72px;object-fit:contain"/>
                        </div>
                        <p class="cw-empty-title">@L10n.T("ai.empty_greeting")</p>
                        <p class="cw-empty-sub">
                            @L10n.T("ai.empty_sub_static")
                        </p>
                        <div class="cw-suggestions">
                            @if (Columns?.Count > 0)
                            {
                                <button class="cw-suggestion-chip"
                                        @onclick='() => QuickAsk("Tóm tắt dữ liệu báo cáo này cho tôi")'>
                                    @L10n.T("ai.chip_summarize")
                                </button>
                                <button class="cw-suggestion-chip"
                                        @onclick='() => QuickAsk("Gợi ý cách lọc dữ liệu hiệu quả")'>
                                    @L10n.T("ai.chip_filter")
                                </button>
                            }
                            <button class="cw-suggestion-chip"
                                    @onclick='() => QuickAsk("Mở bản đồ vị trí salesman hôm nay")'>
                                @L10n.T("ai.chip_map")
                            </button>
                            <button class="cw-suggestion-chip"
                                    @onclick='() => QuickAsk("Mở trang hướng dẫn sử dụng")'>
                                @L10n.T("ai.chip_help")
                            </button>
                            @if (ReportLinks?.Count > 0)
                            {
                                <button class="cw-suggestion-chip"
                                        @onclick='() => QuickAsk("Liệt kê tất cả báo cáo có sẵn")'>
                                    @L10n.T("ai.chip_reports")
                                </button>
                            }
                        </div>
                    </div>
                }

                @* Messages *@
                @foreach (var msg in _messages)
                {
                    @if (msg.Role == "user")
                    {
                        <div class="cw-row cw-row--user">
                            <div class="cw-bubble cw-bubble--user">
                                @((MarkupString)FormatText(msg.Content))
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="cw-row cw-row--ai">
                            <div class="cw-ai-avatar"><img src="images/dmspro-ai.svg" alt="DMSPro AI" style="width:28px;height:28px;object-fit:contain"/></div>
                            <div>
                                <div class="cw-bubble cw-bubble--ai">
                                    @((MarkupString)FormatText(msg.Content))
                                </div>
                                @if (msg.NavActions.Count > 0)
                                {
                                    <div class="cw-nav-actions">
                                        @foreach (var nav in msg.NavActions)
                                        {
                                            var url = nav.Url; var lbl = nav.Label;
                                            <button class="cw-nav-btn" @onclick="() => NavigateTo(url)">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>@lbl
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }

                @* Typing indicator *@
                @if (_busy)
                {
                    <div class="cw-row cw-row--ai">
                        <div class="cw-ai-avatar"><img src="images/dmspro-ai.svg" alt="DMSPro AI" style="width:28px;height:28px;object-fit:contain"/></div>
                        <div class="cw-bubble cw-bubble--ai cw-bubble--typing">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                }

                @* ══ SURVEY CARD ══════════════════════════════════════ *@
                @if (_showSurvey)
                {
                    <div class="cw-row cw-row--ai">
                        <div class="cw-ai-avatar"><img src="images/dmspro-ai.svg" alt="DMSPro AI" style="width:28px;height:28px;object-fit:contain"/></div>
                        <div class="cw-survey-card">
                            <div class="cw-survey-title">
                                <i class="bi bi-stars me-1 text-warning"></i>
                                @L10n.T("ai.survey_title")
                            </div>
                            <p class="cw-survey-sub">@L10n.T("ai.survey_sub")</p>

                            @* Sao *@
                            <div class="cw-stars">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    var star = s;
                                    <button class="cw-star @(_surveyScore >= star ? "cw-star--on" : "")"
                                            @onclick="() => _surveyScore = star"
                                            title="@StarLabel(star)">
                                        <i class="bi bi-star-fill"></i>
                                    </button>
                                }
                            </div>
                            @if (_surveyScore > 0)
                            {
                                <div class="cw-survey-label">@StarLabel(_surveyScore)</div>
                            }

                            @* Feedback text *@
                            @if (_surveyScore > 0)
                            {
                                <textarea class="cw-survey-textarea"
                                          @bind="_surveyFeedback"
                                          placeholder="@(_surveyScore <= 2 ? L10n.T("ai.survey_placeholder_bad") : L10n.T("ai.survey_placeholder_good"))"
                                          rows="2"></textarea>
                                <button class="cw-survey-submit" @onclick="SubmitSurveyAsync">
                                    <i class="bi bi-send me-1"></i>@L10n.T("ai.survey_submit")
                                </button>
                            }

                            <button class="cw-survey-skip" @onclick="SkipSurvey">
                                @L10n.T("ai.survey_skip")
                            </button>
                        </div>
                    </div>
                }

                <div id="cw-scroll-anchor"></div>
            </div>

            @* ── FOOTER ── *@
            <div class="cw-footer">
                <div class="cw-input-wrap @(_busy ? "cw-input-wrap--disabled" : "")">
                    <textarea class="cw-input"
                              @bind="_input"
                              @bind:event="oninput"
                              @onkeydown="OnKeyDown"
                              @onkeydown:preventDefault="@_suppressEnter"
                              placeholder="@(_models.Count == 0 ? "Ollama..." : L10n.T("ai.placeholder"))"
                              rows="1"
                              disabled="@(_busy || _models.Count == 0)"></textarea>
                    <button class="cw-send-btn @(!string.IsNullOrWhiteSpace(_input) && !_busy ? "cw-send-btn--active" : "")"
                            @onclick="SendAsync"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_input) || _models.Count == 0)"
                            title="@L10n.T("ai.send_tooltip")">
                        @if (_busy) { <span class="cw-send-spinner"></span> }
                        else        { <i class="bi bi-send-fill"></i> }
                    </button>
                </div>
                <div class="cw-footer-hint">@L10n.T("ai.footer_hint")</div>
            </div>

        </div>
    }
</div>

@code {
    // ── Parameters ────────────────────────────────────────────
    [Parameter] public string?                     ReportSource { get; set; }
    [Parameter] public IReadOnlyList<string>?      Columns      { get; set; }
    [Parameter] public int                         RowCount     { get; set; }
    [Parameter] public IReadOnlyList<ChatNavLink>? ReportLinks  { get; set; }

    // ── Display message ───────────────────────────────────────
    private sealed class DisplayMessage
    {
        public string            Role       { get; init; } = "";
        public string            Content    { get; init; } = "";
        public List<ChatNavLink> NavActions { get; init; } = [];
        public ChatMessage ToApiMessage()  => new(Role, Content);
    }

    // ── State ─────────────────────────────────────────────────
    private bool   _open;
    private bool   _busy;
    private bool   _suppressEnter;
    private bool   _loadingModels;
    private bool   _historyLoaded;
    private string _input         = "";
    private const  string FixedModel    = "qwen2.5:7b";
    private string _selectedModel = FixedModel;
    private IReadOnlyList<OllamaModel>    _models   = [];
    private readonly List<DisplayMessage> _messages = [];

    // Survey state
    private bool   _showSurvey;
    private int    _surveyScore    = 0;
    private string _surveyFeedback = "";
    private int    _userMessageCount = 0;

    // Greeting state
    private bool _greeted = false;

    // Idle survey: sau 1h chua chat -> hoi cam nhan
    private Timer? _idleSurveyTimer;
    private DateTime _lastUserAction = DateTime.UtcNow;

    // ── System prompt ─────────────────────────────────────────
    private string SystemPrompt
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("Bạn là trợ lý AI trong DMSPRO Reporting — hệ thống báo cáo BI cho DMS.");
            sb.AppendLine("Nhiệm vụ: phân tích dữ liệu, tư vấn báo cáo, ĐIỀU HƯỚNG người dùng, và xử lý khi người dùng không hài lòng.");

            if (!string.IsNullOrEmpty(ReportSource))
            {
                sb.Append($"[Hiện tại] Báo cáo: '{ReportSource}'");
                if (Columns?.Count > 0)
                    sb.Append($" | {RowCount:N0} dòng | Cột: {string.Join(", ", Columns)}");
                sb.AppendLine();
            }

            // Lay toan bo menu tu NavMenuService — bot biet chinh xac trang nao ton tai
            sb.AppendLine();
            sb.AppendLine("=== TOÀN BỘ TRANG TRONG HỆ THỐNG ===");
            sb.AppendLine("(Dùng URL chính xác khi tạo NAVIGATE)");
            var menuGroups = MenuSvc.GetMenu(Auth.Role);
            foreach (var grp in menuGroups)
            {
                sb.AppendLine($"[{grp.Name}]");
                foreach (var item in grp.Items)
                    sb.AppendLine($"  • {item.Title} → {item.Href}");
            }

            // Them cac trang dac biet co query param
            sb.AppendLine("[Trang đặc biệt]");
            sb.AppendLine($"  • Bản đồ hôm nay → /territory-map?date={DateTime.Today:yyyy-MM-dd}");
            sb.AppendLine($"  • Bản đồ ngày khác → /territory-map?date=yyyy-MM-dd");
            sb.AppendLine("  • Hướng dẫn → /help");

            sb.AppendLine();
            sb.AppendLine("=== QUY TẮC ĐIỀU HƯỚNG ===");
            sb.AppendLine("A) Hiểu rõ yêu cầu → tạo [NAVIGATE|<url>|<tên button>] ngay");
            sb.AppendLine("B) Không chắc trang nào phù hợp → hỏi lại VÀ liệt kê 2-3 lựa chọn có nút NAVIGATE để user chọn");
            sb.AppendLine("C) Yêu cầu mơ hồ → hỏi 1 câu làm rõ, sau đó navigate");
            sb.AppendLine("D) Không cần filter → navigate URL gốc ngay");
            sb.AppendLine("VÍ DỤ: User hỏi 'xem doanh số' → [NAVIGATE|/report/summary-sales|Tổng hợp doanh số]");
            sb.AppendLine("VÍ DỤ: User hỏi 'báo cáo nào về nhân viên' → liệt kê và tạo NAVIGATE cho từng trang phù hợp");

            sb.AppendLine();
            sb.AppendLine("=== XỬ LÝ KHI NGƯỜI DÙNG KHÔNG HÀI LÒNG ===");
            sb.AppendLine("Phát hiện từ khoá tiêu cực: chậm, lỗi, sai, tệ, xấu, khó chịu, thất vọng, không hoạt động, bug, hỏng...");
            sb.AppendLine("Bắt buộc:");
            sb.AppendLine("1. Xin lỗi chân thành, ấm áp, cụ thể với vấn đề người dùng đề cập (2-3 câu)");
            sb.AppendLine("2. Thể hiện sự đồng cảm, thừa nhận cảm xúc của người dùng");
            sb.AppendLine("3. KHÔNG đề xuất giải pháp kỹ thuật hay button NAVIGATE trong lượt này");
            sb.AppendLine("4. KHÔNG hỏi thêm câu hỏi — chỉ lắng nghe và xin lỗi");
            sb.AppendLine("5. Kết thúc bằng câu hỏi nhẹ nhàng: hỏi người dùng muốn mình hỗ trợ như thế nào");

            sb.AppendLine();
            var langInstruction = L10n.CurrentLang switch
            {
                "EN" => "ALWAYS respond in English.",
                "ID" => "SELALU jawab dalam Bahasa Indonesia.",
                _    => "LUÔN trả lời bằng Tiếng Việt."
            };
            sb.AppendLine(langInstruction);
            return sb.ToString();
        }
    }

    // ── Greeting khi dang nhap ────────────────────────────────
    /// Goi tu MainLayout sau khi auth thanh cong.
    /// Template co dinh, khong can Ollama.
    public async Task ShowGreetingAsync()
    {
        if (_greeted) return;
        _greeted = true;

        // Mo cua so chat
        _open = true;
        if (_models.Count == 0) await LoadModelsAsync();
        if (!_historyLoaded)    await LoadHistoryAsync();

        // Neu da co lich su hom nay thi khong chen loi chao
        if (_messages.Count > 0) { StateHasChanged(); return; }

        var greeting = BuildGreeting();
        _messages.Add(new DisplayMessage { Role = "assistant", Content = greeting });
        StateHasChanged();
        await ScrollAsync();

        // Bat dau timer kiem tra 1h idle -> hoi cam nhan
        StartIdleSurveyTimer();
    }

    private string BuildGreeting()
    {
        var hour = DateTime.Now.Hour;
        string timeKey, emojiKey;
        if (hour < 12)      { timeKey = "ai.greeting_morning";   emojiKey = "ai.greeting_emoji_morning"; }
        else if (hour < 18) { timeKey = "ai.greeting_afternoon"; emojiKey = "ai.greeting_emoji_afternoon"; }
        else                { timeKey = "ai.greeting_evening";   emojiKey = "ai.greeting_emoji_evening"; }
        var emoji    = L10n.T(emojiKey);
        var timeOfDay= L10n.T(timeKey);
        var sub      = L10n.T("ai.empty_sub");
        var name     = Auth.FullName?.Split(' ').LastOrDefault() ?? Auth.UserName;
        return L10n.CurrentLang switch
        {
            "EN" => $"{emoji} Good {timeOfDay}, **{name}**!\n\n{sub}",
            "ID" => $"{emoji} Selamat {timeOfDay}, **{name}**!\n\n{sub}",
            _    => $"{emoji} Chào {timeOfDay}, **{name}**!\n\n{sub}"
        };
    }

    // ── Toggle & init ─────────────────────────────────────────
    private async Task ToggleAsync()
    {
        _open = !_open;
        if (_open)
        {
            if (_models.Count == 0) await LoadModelsAsync();
            if (!_historyLoaded)   await LoadHistoryAsync();
        }
    }

    private async Task LoadModelsAsync()
    {
        _loadingModels = true; StateHasChanged();
        try
        {
            _models = await Chatbot.GetModelsAsync();
            // Co dinh qwen2.5:7b, kiem tra co ton tai khong, fallback model dau neu khong co
            _selectedModel = _models.Any(m => m.Name == FixedModel)
                ? FixedModel
                : (_models.Count > 0 ? _models[0].Name : FixedModel);
        }
        finally { _loadingModels = false; StateHasChanged(); }
    }

    // ── Load lịch sử hôm nay ─────────────────────────────────
    private async Task LoadHistoryAsync()
    {
        _historyLoaded = true;
        var userId = Auth.UserName;
        if (string.IsNullOrEmpty(userId)) return;

        var history = await History.LoadTodayAsync(userId);
        if (history.Count > 0)
        {
            _messages.Clear();
            foreach (var h in history)
                _messages.Add(new DisplayMessage
                {
                    Role       = h.Role,
                    Content    = h.Content,
                    NavActions = h.NavActions
                });
            _userMessageCount = history.Count(h => h.Role == "user");
            StateHasChanged();
            await ScrollAsync();
        }

        // Kiểm tra survey hôm nay
        await CheckSurveyAsync();
    }

    // ── Xoá lịch sử ──────────────────────────────────────────
    private async Task ClearHistoryAsync()
    {
        _messages.Clear();
        _userMessageCount = 0;
        _showSurvey       = false;
        await History.ClearTodayAsync(Auth.UserName);
        StateHasChanged();
    }

    // ── Send ──────────────────────────────────────────────────
    private async Task QuickAsk(string q) { _input = q; await SendAsync(); }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        _suppressEnter = e.Key == "Enter" && !e.ShiftKey;
        if (_suppressEnter) await SendAsync();
    }

    private async Task SendAsync()
    {
        var text = _input.Trim();
        if (string.IsNullOrEmpty(text) || _busy || string.IsNullOrEmpty(_selectedModel)) return;

        var userMsg = new DisplayMessage { Role = "user", Content = text };
        _messages.Add(userMsg);
        _input = "";
        _busy  = true;
        _userMessageCount++;
        _lastUserAction = DateTime.UtcNow; // reset idle timer
        _showSurvey = false;
        StateHasChanged();
        await ScrollAsync();

        // Lưu tin nhắn user
        _ = History.SaveAsync(Auth.UserName, "user", text);

        try
        {
            // OPTIM: Thu phat hien intent dieu huong nhanh (khong can LLM)
            // Neu khop -> tra ket qua ngay, tranh round-trip ~3-5s
            var fastResult = TryFastNavigate(text);
            string raw;
            if (fastResult != null)
            {
                raw = fastResult;
            }
            else
            {
                var history = _messages.Take(_messages.Count - 1)
                                       .Select(m => m.ToApiMessage()).ToList();
                raw = await Chatbot.SendAsync(_selectedModel, history, text, SystemPrompt);
            }

            var (clean, navs) = ParseNavigate(raw);
            var aiMsg = new DisplayMessage { Role = "assistant", Content = clean, NavActions = navs };
            _messages.Add(aiMsg);

            _ = History.SaveAsync(Auth.UserName, "assistant", clean, navs);
        }
        catch (Exception ex)
        {
            var err = new DisplayMessage { Role = "assistant", Content = $"⚠ {ex.Message}" };
            _messages.Add(err);
        }
        finally
        {
            _busy = false; StateHasChanged();
            await ScrollAsync();
        }
    }

    // ── Survey ────────────────────────────────────────────────
    private async Task CheckSurveyAsync()
    {
        if (_showSurvey) return;
        var userId = Auth.UserName;
        if (string.IsNullOrEmpty(userId)) return;

        var result = await Survey.GetTodayAsync(userId);
        if (!result.Completed)
        {
            _showSurvey = true;
            StateHasChanged();
            await ScrollAsync();
        }
    }

    private async Task SubmitSurveyAsync()
    {
        if (_surveyScore == 0) return;
        await Survey.SaveAsync(Auth.UserName, _surveyScore, _surveyFeedback.Trim());
        _showSurvey = false;
        StateHasChanged();

        // Tự động xử lý nếu không hài lòng (1-2 sao)
        if (_surveyScore <= 2)
        {
            await AutoApologyAsync(_surveyFeedback.Trim());
        }
        else
        {
            var thanks = new DisplayMessage
            {
                Role    = "assistant",
                Content = _surveyScore == 5
                    ? L10n.T("ai.survey_thanks_5")
                    : L10n.T("ai.survey_thanks_good")
            };
            _messages.Add(thanks);
            _ = History.SaveAsync(Auth.UserName, "assistant", thanks.Content);
            StateHasChanged();
            await ScrollAsync();
        }

        _surveyScore    = 0;
        _surveyFeedback = "";
    }

    private async Task SkipSurvey()
    {
        _showSurvey = false;
        StateHasChanged();
    }

    private async Task AutoApologyAsync(string feedback)
    {
        _busy = true; StateHasChanged();
        try
        {
            // Gửi đến LLM để sinh câu xin lỗi + đề xuất khắc phục tự động
            var context = string.IsNullOrEmpty(feedback)
                ? "Người dùng cho 1-2 sao nhưng không nêu lý do cụ thể."
                : $"Người dùng cho {_surveyScore} sao và phản hồi: \"{feedback}\"";

            var prompt = $"{context} Hãy: 1) Xin lỗi chân thành, 2) Thừa nhận vấn đề, " +
                         $"3) Đề xuất giải pháp cụ thể kèm NAVIGATE nếu phù hợp. Trả lời bằng tiếng Việt.";

            var raw = await Chatbot.SendAsync(_selectedModel, [], prompt, SystemPrompt);
            var (clean, navs) = ParseNavigate(raw);

            var msg = new DisplayMessage { Role = "assistant", Content = clean, NavActions = navs };
            _messages.Add(msg);
            _ = History.SaveAsync(Auth.UserName, "assistant", clean, navs);
        }
        catch
        {
            var fallback = new DisplayMessage
            {
                Role    = "assistant",
                Content = "Chúng tôi thành thật xin lỗi vì trải nghiệm chưa tốt của bạn. " +
                          "Phản hồi của bạn rất quan trọng và chúng tôi sẽ khắc phục sớm nhất. " +
                          "Bạn có thể thử tải lại trang hoặc liên hệ quản trị viên nếu vấn đề còn tiếp diễn.",
                NavActions = [new ChatNavLink(L10n.T("ai.nav_reload_report"), "/report"),
                              new ChatNavLink(L10n.T("ai.nav_view_help"),    "/help")]
            };
            _messages.Add(fallback);
        }
        finally
        {
            _busy = false; StateHasChanged();
            await ScrollAsync();
        }
    }

    // ── Fast Navigate — xu ly dieu huong khong can LLM ────────
    // Khop keyword -> tra NAVIGATE string ngay (~0ms thay vi 3-5s)
    private string? TryFastNavigate(string input)
    {
        var t = input.ToLower().Trim();
        var today = DateTime.Today.ToString("yyyy-MM-dd");

        // Lay danh sach menu de map dong
        var allItems = MenuSvc.GetMenu(Auth.Role)
            .SelectMany(g => g.Items)
            .ToList();

        // Uu tien khop chinh xac Title menu (case-insensitive)
        foreach (var item in allItems)
        {
            if (t.Contains(item.Title.ToLower()) || t.Contains(item.Href.ToLower()))
                return $"Mở **{item.Title}** cho bạn ngay! [NAVIGATE|{item.Href}|{item.Title}]";
        }

        // Keyword mapping nhanh cho cac cum tu pho bien
        var keywords = new[]
        {
            // Dashboard
            (new[]{"dashboard","tổng quan","tong quan","kpi tổng","home"}, "/dashboard", "Dashboard"),
            // Reports
            (new[]{"viếng thăm","vieng tham","visit","báo cáo vt","bao cao vt"}, "/report/visit", "Báo cáo viếng thăm"),
            (new[]{"tổng hợp kpi","tong hop kpi","sm visit","visit summary"}, "/report/summary", "Tổng hợp KPI"),
            (new[]{"tổng hợp doanh số","tong hop doanh so","summary sales","doanh số tổng"}, "/report/summary-sales", "Tổng hợp doanh số"),
            (new[]{"doanh số ngày","doanh so ngay","daily mtd","mtd"}, "/report/sales-daily", "Doanh số ngày MTD"),
            (new[]{"hiệu quả","hieu qua","sales effective"}, "/report/sales-effective", "Bán hàng hiệu quả"),
            (new[]{"pc theo","pc nhân viên","pc by"}, "/report/pc-sm", "PC theo nhân viên"),
            (new[]{"lý do viếng","ly do vieng","visit reason"}, "/report/visit-reason", "Lý do viếng thăm"),
            (new[]{"3g offline","offline"}, "/report/3g-offline", "3G Offline"),
            (new[]{"gps sai","gps không hợp lệ","outlet gps"}, "/report/outlet-invalid-location", "Outlet GPS"),
            (new[]{"ch chưa vt","ch chua vt","chưa viếng","outlet not visit"}, "/report/outlet-not-visit-mcp", "CH chưa VT MCP"),
            (new[]{"hình ảnh","hinh anh","display image","trưng bày"}, "/report/display-image", "Hình ảnh trưng bày"),
            (new[]{"user log","nhật ký","nhat ky","user action"}, "/report/user-log", "Nhật ký người dùng"),
            (new[]{"chấm công","cham cong","timekeeping"}, "/report/timekeeping", "Chấm công"),
            (new[]{"mobility","dùng app","dung app","sử dụng app"}, "/report/user-mobility", "TDV dùng App"),
            (new[]{"issues","vấn đề","van de","sự cố","su co"}, "/report/issues-full", "Báo cáo Issues"),
            // Map
            (new[]{"bản đồ","ban do","map","territory","vị trí"}, $"/territory-map?date={today}", "Bản đồ hôm nay"),
            (new[]{"tracking","theo dõi","theo doi","giám sát di chuyển"}, "/tracking", "Theo dõi nhân viên"),
            // MCP
            (new[]{"mcp report","báo cáo mcp","bao cao mcp"}, "/mcp/report", "Báo cáo MCP"),
            (new[]{"mcp detail","chi tiết mcp","chi tiet mcp"}, "/mcp/detail", "Chi tiết MCP"),
            // Distribution
            (new[]{"phân phối sku","phan phoi sku","distribution","sku"}, "/distribution", "Phân phối SKU"),
            (new[]{"budget","ngân sách","ngan sach"}, "/distribution/budget", "Phân bổ Budget"),
            // Admin
            (new[]{"bảo mật","bao mat","security","audit log","session"}, "/admin/security", "Bảo mật hệ thống"),
            (new[]{"người dùng","nguoi dung","user management"}, "/user", "Quản lý người dùng"),
            (new[]{"role","quyền","quyen","phân quyền","phan quyen"}, "/account/roles", "Quản lý Role"),
            // Help
            (new[]{"hướng dẫn","huong dan","help","trợ giúp","tro giup"}, "/help", "Hướng dẫn"),
        };

        foreach (var (keys, url, label) in keywords)
        {
            if (keys.Any(k => t.Contains(k)))
                return $"Mở **{label}** cho bạn ngay! [NAVIGATE|{url}|{label}]";
        }

        // Cau hoi liet ke bao cao -> tra nhanh khong can LLM
        if (t.Contains("có báo cáo") || t.Contains("co bao cao") ||
            t.Contains("báo cáo nào") || t.Contains("bao cao nao") ||
            t.Contains("danh sách") || t.Contains("liệt kê"))
        {
            var reportItems = MenuSvc.GetMenu(Auth.Role)
                .Where(g => g.Name == "Báo cáo")
                .SelectMany(g => g.Items)
                .ToList();
            if (reportItems.Any())
            {
                var sb = new System.Text.StringBuilder();
                sb.AppendLine("Hệ thống có các báo cáo sau:\n");
                foreach (var item in reportItems)
                    sb.AppendLine($"• {item.Title} [NAVIGATE|{item.Href}|{item.Title}]");
                return sb.ToString();
            }
        }

        return null; // Khong khop -> goi LLM
    }

