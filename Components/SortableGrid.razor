@typeparam TItem
@using System.Linq.Expressions
@inject LocalizationService L10n

@* ══════════════════════════════════════════════════════════════
   SortableGrid<TItem> — Generic grid với sort + filter + paging

   Cách dùng:
   <SortableGrid Items="_data" Context="r">
       <Columns>
           <GridColumn Title="Tên" Value="@(x => x.Name)" />
           <GridColumn Title="Tuổi" Value="@(x => x.Age)" Align="end" />
       </Columns>
       <RowTemplate>
           <td>@r.Name</td>
           <td class="text-end">@r.Age</td>
       </RowTemplate>
   </SortableGrid>
   ══════════════════════════════════════════════════════════════ *@

@* Render Columns fragment ẩn để GridColumn components tự đăng ký qua cascade *@
<CascadingValue Value="this" IsFixed="true">
    <div style="display:none">@Columns</div>
</CascadingValue>

<div class="sg-wrapper">
    @* ── Toolbar ── *@
    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
        <input class="form-control form-control-sm" style="max-width:220px"
               placeholder="@L10n.T("grid.search_placeholder")" value="@_search"
               @oninput="OnSearch" />
        <span class="text-muted small ms-1">@_filtered.Count / @Items.Count() @L10n.T("grid.rows_suffix")</span>
        <div class="ms-auto d-flex gap-2 align-items-center">
            @if (ToolbarContent is not null)
            {
                @ToolbarContent
            }
            <select class="form-select form-select-sm" style="width:80px"
                    @bind="_pageSize" @bind:after="GoFirst">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>

    @* ── Table ── *@
    <div style="overflow-x:auto;overflow-y:auto;max-height:@MaxHeight;border:1px solid #dee2e6;border-radius:4px">
        <table class="table table-hover table-sm align-middle mb-0" style="min-width:@MinWidth">
            <thead class="table-dark sticky-top">
                <tr>
                    @foreach (var col in _columns)
                    {
                        <th class="@(col.Align == "end" ? "text-end" : col.Align == "center" ? "text-center" : "")"
                            style="cursor:pointer;user-select:none;white-space:nowrap"
                            @onclick="() => Sort(col)">
                            @col.Title
                            @if (_sortCol == col)
                            {
                                <i class="bi @(_sortAsc ? "bi-sort-up" : "bi-sort-down") ms-1" style="font-size:.75rem"></i>
                            }
                            else
                            {
                                <i class="bi bi-arrow-down-up ms-1 opacity-25" style="font-size:.7rem"></i>
                            }
                        </th>
                    }
                    @if (ActionColumn is not null)
                    {
                        <th class="text-center" style="white-space:nowrap">@L10n.T("grid.action")</th>
                    }
                </tr>
                @* Filter row *@
                <tr class="table-secondary">
                    @foreach (var col in _columns)
                    {
                        <td class="py-1 @(col.Align == "end" ? "text-end" : "")">
                            @if (col.Filterable)
                            {
                                <input class="form-control form-control-sm py-0"
                                       style="font-size:.75rem;min-width:60px"
                                       placeholder="@L10n.T("grid.filter_placeholder")"
                                       value="@col.FilterValue"
                                       @oninput="e => OnColFilter(col, e.Value?.ToString() ?? string.Empty)" />
                            }
                        </td>
                    }
                    @if (ActionColumn is not null)
                    {
                        <td class="py-1 text-center">
                            @if (_columns.Any(c => !string.IsNullOrEmpty(c.FilterValue)) || !string.IsNullOrEmpty(_search))
                            {
                                <button class="btn btn-xs btn-outline-secondary py-0"
                                        style="font-size:.7rem" @onclick="ClearFilters">
                                    <i class="bi bi-x"></i> @L10n.T("grid.clear_filters")
                                </button>
                            }
                        </td>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!_paged.Any())
                {
                    var colCount = _columns.Count + (ActionColumn is not null ? 1 : 0);
                    <tr><td colspan="@colCount" class="text-center text-muted py-4">
                        <i class="bi bi-inbox me-2"></i>@L10n.T("lbl.no_data")
                    </td></tr>
                }
                else if (_paged.Count > 100)
                {
                    @* M3-FIX: Virtualize khi > 100 rows, chi render rows hien thi trong viewport *@
                    <Virtualize Items="_paged" Context="item" OverscanCount="5">
                        <tr>
                            @RowTemplate(item)
                            @if (ActionColumn is not null)
                            {
                                <td class="text-center" style="white-space:nowrap">
                                    @ActionColumn(item)
                                </td>
                            }
                        </tr>
                    </Virtualize>
                }
                else
                {
                    @foreach (var item in _paged)
                    {
                        <tr>
                            @RowTemplate(item)
                            @if (ActionColumn is not null)
                            {
                                <td class="text-center" style="white-space:nowrap">
                                    @ActionColumn(item)
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* ── Paging ── *@
    <div class="d-flex align-items-center justify-content-between mt-2 flex-wrap gap-2">
        <div class="text-muted small">
            @if (_filtered.Count > 0)
            {
                var from = (_page - 1) * _pageSize + 1;
                var to   = Math.Min(_page * _pageSize, _filtered.Count);
                <span>@from–@to / @_filtered.Count @L10n.T("grid.rows_suffix")</span>
            }
        </div>
        @if (_totalPages > 1)
        {
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_page==1?"disabled":"")">
                        <button class="page-link" @onclick="()=>GoPage(1)">
                            <i class="bi bi-chevron-double-left"></i>
                        </button>
                    </li>
                    <li class="page-item @(_page==1?"disabled":"")">
                        <button class="page-link" @onclick="()=>GoPage(_page-1)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </li>
                    @foreach (var p in VisiblePages)
                    {
                        <li class="page-item @(p==_page?"active":"")">
                            <button class="page-link" @onclick="()=>GoPage(p)">@p</button>
                        </li>
                    }
                    <li class="page-item @(_page==_totalPages?"disabled":"")">
                        <button class="page-link" @onclick="()=>GoPage(_page+1)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </li>
                    <li class="page-item @(_page==_totalPages?"disabled":"")">
                        <button class="page-link" @onclick="()=>GoPage(_totalPages)">
                            <i class="bi bi-chevron-double-right"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment<TItem> RowTemplate { get; set; } = null!;
    [Parameter] public RenderFragment<TItem>? ActionColumn { get; set; }
    [Parameter] public RenderFragment? ToolbarContent { get; set; }
    [Parameter] public RenderFragment? Columns { get; set; }  // trigger GridColumn cascade registration
    [Parameter] public string MaxHeight { get; set; } = "600px";
    [Parameter] public string MinWidth  { get; set; } = "600px";
    [Parameter] public int DefaultPageSize { get; set; } = 20;

    // Columns đăng ký từ child GridColumn components
    internal List<GridColumn<TItem>> _columns = new();

    private string _search = "";
    private int _page = 1;
    private int _pageSize = 20;
    private GridColumn<TItem>? _sortCol;
    private bool _sortAsc = true;

    private List<TItem> _filtered = new();
    private List<TItem> _paged    = new();
    private int _totalPages = 1;

    protected override void OnParametersSet()
    {
        _pageSize = DefaultPageSize;
        Recompute();
    }

    internal void RegisterColumn(GridColumn<TItem> col)
    {
        if (!_columns.Contains(col)) _columns.Add(col);
        Recompute();
        StateHasChanged();
    }

    internal void UnregisterColumn(GridColumn<TItem> col)
    {
        _columns.Remove(col);
        StateHasChanged();
    }

    private void Recompute()
    {
        var q = Items.AsEnumerable();

        // Global search
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim();
            q = q.Where(item => _columns.Any(col =>
                col.GetString(item).Contains(s, StringComparison.OrdinalIgnoreCase)));
        }

        // Column filters
        foreach (var col in _columns.Where(c => !string.IsNullOrEmpty(c.FilterValue)))
        {
            var f = col.FilterValue!;
            q = q.Where(item => col.GetString(item).Contains(f, StringComparison.OrdinalIgnoreCase));
        }

        // Sort
        if (_sortCol is not null)
        {
            q = _sortAsc
                ? q.OrderBy(item => _sortCol.GetComparable(item))
                : q.OrderByDescending(item => _sortCol.GetComparable(item));
        }

        _filtered    = q.ToList();
        _totalPages  = Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)_pageSize));
        _page        = Math.Clamp(_page, 1, _totalPages);
        _paged       = _filtered.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList();
    }

    private void Sort(GridColumn<TItem> col)
    {
        if (_sortCol == col) _sortAsc = !_sortAsc;
        else { _sortCol = col; _sortAsc = true; }
        Recompute();
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _page   = 1;
        Recompute();
    }

    private void OnColFilter(GridColumn<TItem> col, string value)
    {
        col.FilterValue = value;
        _page = 1;
        Recompute();
    }

    private void ClearFilters()
    {
        _search = "";
        foreach (var c in _columns) c.FilterValue = "";
        _page = 1;
        Recompute();
    }

    private void GoFirst() { _page = 1; Recompute(); }
    private void GoPage(int p) { _page = Math.Clamp(p, 1, _totalPages); Recompute(); }

    private IEnumerable<int> VisiblePages
    {
        get
        {
            int s = Math.Max(1, _page - 2);
            int e = Math.Min(_totalPages, s + 4);
            s = Math.Max(1, e - 4);
            return Enumerable.Range(s, e - s + 1);
        }
    }
}
