@page "/account/change-password"
@attribute [NavMenu(Title="Đổi mật khẩu", Icon="bi-key-fill", Group="Quản trị", GroupOrder=90, Order=40)]
@using BlazorReporting.Services
@inject AuthService Auth
@inject UserManagementService UserSvc
@inject NavigationManager Nav
@inject LocalizationService L10n

<PageTitle>@L10n.T("change_password.title")</PageTitle>

<div class="container mt-4" style="max-width:480px">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-key-fill me-2"></i>@L10n.T("change_password.title")
        </div>
        <div class="card-body">

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="alert @(_success ? "alert-success" : "alert-danger")">@_message</div>
            }

            <div class="mb-3">
                <label class="form-label">@L10n.T("change_password.old_password")</label>
                <input type="password" class="form-control" @bind="_oldPass" placeholder="@L10n.T("change_password.old_password_placeholder")" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L10n.T("change_password.new_password")</label>
                <input type="password" class="form-control" @bind="_newPass" placeholder="@L10n.T("change_password.new_password_placeholder")" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L10n.T("change_password.confirm_password")</label>
                <input type="password" class="form-control" @bind="_confirmPass" placeholder="@L10n.T("change_password.confirm_password_placeholder")" />
            </div>

            <button class="btn btn-primary w-100" @onclick="SubmitAsync" disabled="@_loading">
                @if (_loading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                @L10n.T("change_password.title")
            </button>
        </div>
    </div>
</div>

@code {
    private string _oldPass = "", _newPass = "", _confirmPass = "";
    private string _message = "";
    private bool _success, _loading;

    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn) Nav.NavigateTo("/", replace: true);
    }

    private async Task SubmitAsync()
    {
        _message = "";
        if (string.IsNullOrWhiteSpace(_oldPass) || string.IsNullOrWhiteSpace(_newPass))
        {
            _message = L10n.T("change_password.error_required"); return;
        }
        if (_newPass != _confirmPass)
        {
            _message = L10n.T("change_password.error_mismatch"); return;
        }
        if (_newPass.Length < 6)
        {
            _message = L10n.T("change_password.error_min_length"); return;
        }

        _loading = true;
        var ok = await UserSvc.ChangePasswordAsync(Auth.UserName, _oldPass, _newPass);
        _loading = false;

        if (ok)
        {
            _success = true;
            _message = L10n.T("change_password.success");
            _oldPass = _newPass = _confirmPass = "";
        }
        else
        {
            _success = false;
            _message = L10n.T("change_password.error_wrong_old");
        }
    }
}
