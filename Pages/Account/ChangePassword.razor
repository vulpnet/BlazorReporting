@page "/account/change-password"
@attribute [NavMenu(Title="Đổi mật khẩu", Icon="bi-key-fill", Group="Quản trị", GroupOrder=90, Order=40)]
@using BlazorReporting.Services
@inject AuthService Auth
@inject UserManagementService UserSvc
@inject NavigationManager Nav

<PageTitle>Đổi mật khẩu</PageTitle>

<div class="container mt-4" style="max-width:480px">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-key-fill me-2"></i>Đổi mật khẩu
        </div>
        <div class="card-body">

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="alert @(_success ? "alert-success" : "alert-danger")">@_message</div>
            }

            <div class="mb-3">
                <label class="form-label">Mật khẩu cũ</label>
                <input type="password" class="form-control" @bind="_oldPass" placeholder="Nhập mật khẩu cũ" />
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu mới</label>
                <input type="password" class="form-control" @bind="_newPass" placeholder="Tối thiểu 6 ký tự" />
            </div>
            <div class="mb-3">
                <label class="form-label">Xác nhận mật khẩu mới</label>
                <input type="password" class="form-control" @bind="_confirmPass" placeholder="Nhập lại mật khẩu mới" />
            </div>

            <button class="btn btn-primary w-100" @onclick="SubmitAsync" disabled="@_loading">
                @if (_loading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                Đổi mật khẩu
            </button>
        </div>
    </div>
</div>

@code {
    private string _oldPass = "", _newPass = "", _confirmPass = "";
    private string _message = "";
    private bool _success, _loading;

    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn) Nav.NavigateTo("/", replace: true);
    }

    private async Task SubmitAsync()
    {
        _message = "";
        if (string.IsNullOrWhiteSpace(_oldPass) || string.IsNullOrWhiteSpace(_newPass))
        {
            _message = "Vui lòng nhập đầy đủ thông tin."; return;
        }
        if (_newPass != _confirmPass)
        {
            _message = "Mật khẩu xác nhận không khớp."; return;
        }
        if (_newPass.Length < 6)
        {
            _message = "Mật khẩu mới phải có ít nhất 6 ký tự."; return;
        }

        _loading = true;
        var ok = await UserSvc.ChangePasswordAsync(Auth.UserName, _oldPass, _newPass);
        _loading = false;

        if (ok)
        {
            _success = true;
            _message = "Mật khẩu đã được thay đổi thành công.";
            _oldPass = _newPass = _confirmPass = "";
        }
        else
        {
            _success = false;
            _message = "Mật khẩu cũ không đúng.";
        }
    }
}
