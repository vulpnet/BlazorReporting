@page "/account/reset-password"
@using BlazorReporting.Services
@inject UserManagementService UserSvc
@inject NavigationManager Nav

<PageTitle>Đặt lại mật khẩu</PageTitle>

<div class="container mt-4" style="max-width:480px">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <i class="bi bi-shield-lock-fill me-2"></i>Đặt lại mật khẩu
        </div>
        <div class="card-body">

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="alert @(_success ? "alert-success" : "alert-danger")">@_message</div>
            }

            @if (_tokenValid && !_success)
            {
                <p class="text-muted mb-3">Tài khoản: <strong>@_userName</strong></p>

                <div class="mb-3">
                    <label class="form-label">Mật khẩu mới</label>
                    <input type="password" class="form-control" @bind="_newPass" placeholder="Tối thiểu 6 ký tự" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Xác nhận mật khẩu mới</label>
                    <input type="password" class="form-control" @bind="_confirmPass" />
                </div>

                <button class="btn btn-warning w-100" @onclick="SubmitAsync" disabled="@_loading">
                    @if (_loading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    Xác nhận đặt lại mật khẩu
                </button>
            }
            else if (!_tokenValid)
            {
                <div class="alert alert-danger">Token không hợp lệ hoặc đã hết hạn.</div>
                <a href="/" class="btn btn-outline-secondary w-100">Về trang đăng nhập</a>
            }

            @if (_success)
            {
                <a href="/" class="btn btn-primary w-100 mt-2">Đăng nhập</a>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string _newPass = "", _confirmPass = "";
    private string _message = "", _userName = "";
    private bool _success, _loading, _tokenValid;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token)) return;
        _userName = await UserSvc.GetUserNameByTokenAsync(Token) ?? "";
        _tokenValid = !string.IsNullOrEmpty(_userName);
    }

    private async Task SubmitAsync()
    {
        _message = "";
        if (_newPass != _confirmPass) { _message = "Mật khẩu xác nhận không khớp."; return; }
        if (_newPass.Length < 6) { _message = "Mật khẩu mới phải có ít nhất 6 ký tự."; return; }

        _loading = true;
        var ok = await UserSvc.ResetPasswordByTokenAsync(Token!, _newPass);
        _loading = false;

        if (ok)
        {
            _success = true;
            _message = "Đặt lại mật khẩu thành công. Vui lòng đăng nhập.";
        }
        else
        {
            _message = "Đặt lại mật khẩu thất bại. Vui lòng liên hệ quản trị viên.";
        }
    }
}
