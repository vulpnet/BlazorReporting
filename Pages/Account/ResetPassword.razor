@page "/account/reset-password"
@using BlazorReporting.Services
@inject UserManagementService UserSvc
@inject NavigationManager Nav
@inject LocalizationService L10n

<PageTitle>@L10n.T("reset_pw.title")</PageTitle>

<div class="container mt-4" style="max-width:480px">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <i class="bi bi-shield-lock-fill me-2"></i>@L10n.T("reset_pw.title")
        </div>
        <div class="card-body">

            @if (!string.IsNullOrEmpty(_message))
            {
                <div class="alert @(_success ? "alert-success" : "alert-danger")">@_message</div>
            }

            @if (_tokenValid && !_success)
            {
                <p class="text-muted mb-3">@L10n.T("reset_pw.account_label") <strong>@_userName</strong></p>

                <div class="mb-3">
                    <label class="form-label">@L10n.T("reset_pw.new_password")</label>
                    <input type="password" class="form-control" @bind="_newPass" placeholder="@L10n.T("reset_pw.new_password_placeholder")" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@L10n.T("reset_pw.confirm_password")</label>
                    <input type="password" class="form-control" @bind="_confirmPass" />
                </div>

                <button class="btn btn-warning w-100" @onclick="SubmitAsync" disabled="@_loading">
                    @if (_loading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    @L10n.T("reset_pw.btn_submit")
                </button>
            }
            else if (!_tokenValid)
            {
                <div class="alert alert-danger">@L10n.T("reset_pw.error_invalid_token")</div>
                <a href="/" class="btn btn-outline-secondary w-100">@L10n.T("reset_pw.back_to_login")</a>
            }

            @if (_success)
            {
                <a href="/" class="btn btn-primary w-100 mt-2">@L10n.T("reset_pw.btn_login")</a>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string _newPass = "", _confirmPass = "";
    private string _message = "", _userName = "";
    private bool _success, _loading, _tokenValid;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token)) return;
        _userName = await UserSvc.GetUserNameByTokenAsync(Token) ?? "";
        _tokenValid = !string.IsNullOrEmpty(_userName);
    }

    private async Task SubmitAsync()
    {
        _message = "";
        if (_newPass != _confirmPass) { _message = L10n.T("reset_pw.error_password_mismatch"); return; }
        if (_newPass.Length < 6) { _message = L10n.T("reset_pw.error_password_too_short"); return; }

        _loading = true;
        var ok = await UserSvc.ResetPasswordByTokenAsync(Token!, _newPass);
        _loading = false;

        if (ok)
        {
            _success = true;
            _message = L10n.T("reset_pw.success_message");
        }
        else
        {
            _message = L10n.T("reset_pw.error_failed");
        }
    }
}
