@page "/distribution/budget"
@attribute [NavMenu(Title="budget_assign.title", Icon="bi-currency-dollar", Group="nav.distribution_group", GroupOrder=30, Order=20)]
@using BlazorReporting.Services
@inject AuthService Auth
@inject DistributionService DistSvc
@inject NavigationManager Nav
@inject LocalizationService L10n

<PageTitle>@L10n.T("budget_assign.title")</PageTitle>

<div class="container-fluid mt-3">
    <h5 class="mb-3"><i class="bi bi-currency-dollar me-2"></i>@L10n.T("budget_assign.heading")</h5>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert @(_ok?"alert-success":"alert-danger") py-2 alert-dismissible">
            @_msg <button class="btn-close" @onclick="ClearMsg"></button>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center py-4"><span class="spinner-border text-primary"></span></div>
    }
    else
    {
        <SortableGrid Items="_assigns" Context="r" MinWidth="900px" DefaultPageSize="20">
            <ToolbarContent>
                <button class="btn btn-sm btn-primary" @onclick="OpenAdd">
                    <i class="bi bi-plus-lg me-1"></i>@L10n.T("budget_assign.btn_new")
                </button>
            </ToolbarContent>
            <Columns>
                <GridColumn TItem="BudgetAssignRow" Title="@L10n.T("budget_assign.col_salesman")"     Value="@(x => x.SalesmanName)" />
                <GridColumn TItem="BudgetAssignRow" Title="@L10n.T("budget_assign.col_supervisor")"   Value="@(x => x.SalesSupName)" />
                <GridColumn TItem="BudgetAssignRow" Title="@L10n.T("budget_assign.col_budget")"       Value="@(x => x.BudgetName)" />
                <GridColumn TItem="BudgetAssignRow" Title="@L10n.T("budget_assign.col_target")"       Value="@(x => x.Target)" Align="end" />
                <GridColumn TItem="BudgetAssignRow" Title="@L10n.T("budget_assign.col_budget_value")" Value="@(x => x.BudgetValue)" Align="end" />
            </Columns>
            <RowTemplate>
                <td class="fw-semibold">@r.SalesmanName <small class="text-muted">(@r.SalesmanCode)</small></td>
                <td class="small text-muted">@r.SalesSupName</td>
                <td><span class="badge bg-info text-dark">@r.BudgetName</span></td>
                <td class="text-end">@r.Target.ToString("N0")</td>
                <td class="text-end text-success fw-bold">@r.BudgetValue.ToString("N0")</td>
            </RowTemplate>
            <ActionColumn Context="r">
                <button class="btn btn-xs btn-outline-success" title="@L10n.T("budget_assign.btn_approve")" @onclick="()=>ApproveAsync(r)">
                    <i class="bi bi-check-circle"></i>
                </button>
            </ActionColumn>
        </SortableGrid>
    }
</div>

@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L10n.T("budget_assign.modal_title")</h5>
                    <button class="btn-close" @onclick="()=>_showModal=false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label">@L10n.T("budget_assign.lbl_salesman_code")</label>
                            <input class="form-control" @bind="_fSalesmanCode" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">@L10n.T("budget_assign.lbl_salesman_name")</label>
                            <input class="form-control" @bind="_fSalesmanName" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">@L10n.T("budget_assign.lbl_ss_code")</label>
                            <input class="form-control" @bind="_fSSCode" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">@L10n.T("budget_assign.lbl_ss_name")</label>
                            <input class="form-control" @bind="_fSSName" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">@L10n.T("budget_assign.lbl_budget")</label>
                            <select class="form-select" @bind="_fBudgetCode">
                                <option value="">@L10n.T("budget_assign.select_budget_placeholder")</option>
                                @foreach (var b in _budgets)
                                {
                                    <option value="@b.BudgetCode">@b.BudgetName</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">@L10n.T("budget_assign.lbl_target")</label>
                            <input class="form-control" type="number" @bind="_fTarget" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="()=>_showModal=false">@L10n.T("btn.cancel")</button>
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @L10n.T("btn.save")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BudgetAssignRow> _assigns = new();
    private List<BudgetRow> _budgets = new();
    private bool _loading = true, _showModal, _saving, _ok;
    private string _msg = "", _fSalesmanCode = "", _fSalesmanName = "";
    private string _fSSCode = "", _fSSName = "", _fBudgetCode = "";
    private decimal _fTarget;

    private void ClearMsg() => _msg = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn) { Nav.NavigateTo("/", replace: true); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var t1 = DistSvc.GetBudgetAssignsAsync(Auth.UserName);
        var t2 = DistSvc.GetBudgetsAsync(Auth.UserName);
        await Task.WhenAll(t1, t2);
        _assigns = t1.Result;
        _budgets  = t2.Result;
        _loading = false;
    }

    private void OpenAdd()
    {
        _fSalesmanCode = ""; _fSalesmanName = ""; _fSSCode = ""; _fSSName = "";
        _fBudgetCode = ""; _fTarget = 0;
        _showModal = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_fSalesmanCode) || string.IsNullOrWhiteSpace(_fBudgetCode))
        { _ok=false; _msg=L10n.T("budget_assign.err_required_fields"); return; }

        _saving = true;
        var budget = _budgets.FirstOrDefault(b => b.BudgetCode == _fBudgetCode);
        var row = new BudgetAssignRow
        {
            SalesmanCode = _fSalesmanCode, SalesmanName = _fSalesmanName,
            SalesSupCode = _fSSCode,       SalesSupName = _fSSName,
            BudgetCode   = _fBudgetCode,   BudgetName   = budget?.BudgetName ?? "",
            BudgetValue  = budget?.Value ?? 0, Target = _fTarget
        };
        var (ok, msg) = await DistSvc.InsertBudgetAssignAsync(row, Auth.UserName);
        _ok = ok; _msg = msg;
        if (ok)
        {
            _assigns = await DistSvc.GetBudgetAssignsAsync(Auth.UserName);
            _showModal = false;
        }
        _saving = false;
    }

    private async Task ApproveAsync(BudgetAssignRow r)
    {
        var (ok, msg) = await DistSvc.ApproveBudgetAsync(r.SalesmanCode, r.BudgetCode, Auth.UserName);
        _ok = ok; _msg = msg;
        if (ok) _assigns = await DistSvc.GetBudgetAssignsAsync(Auth.UserName);
    }
}
