@page "/distribution"
@attribute [NavMenu(Title="dist.nav_title", Icon="bi-box-seam-fill", Group="nav.distribution", GroupOrder=30, Order=10)]
@using BlazorReporting.Services
@inject AuthService Auth
@inject DistributionService DistSvc
@inject NavigationManager Nav
@inject LocalizationService L10n

<PageTitle>@L10n.T("dist.page_title")</PageTitle>

<div class="container-fluid mt-3">
    <h5 class="mb-3"><i class="bi bi-box-seam-fill me-2"></i>@L10n.T("dist.page_title")</h5>

    @* Filter bar *@
    <div class="card shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="d-flex gap-2 flex-wrap align-items-end">
                <div>
                    <label class="form-label small mb-1">@L10n.T("lbl.date")</label>
                    <input type="date" class="form-control form-control-sm" @bind="_date" />
                </div>
                <div style="min-width:240px">
                    <label class="form-label small mb-1">@L10n.T("dist.lbl_distributor_required")</label>
                    <select class="form-select form-select-sm" @bind="_distCode">
                        <option value="">@L10n.T("dist.select_distributor_placeholder")</option>
                        @foreach (var d in _distributors)
                        {
                            <option value="@d.DistributorCode">@d.DistributorCode — @d.DistributorName</option>
                        }
                    </select>
                </div>
                <button class="btn btn-sm btn-primary" @onclick="LoadDataAsync" disabled="@(string.IsNullOrEmpty(_distCode))">
                    <i class="bi bi-search me-1"></i>@L10n.T("btn.view")
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert @(_ok?"alert-success":"alert-danger") py-2 alert-dismissible">
            @_msg <button class="btn-close" @onclick="ClearMsg"></button>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center py-4"><span class="spinner-border text-primary"></span></div>
    }
    else if (_data.Any())
    {
        <SortableGrid Items="_data" Context="r" MinWidth="1000px" DefaultPageSize="20">
            <Columns>
                <GridColumn TItem="DistributionRow" Title="Salesman"    Value="@(x => x.SalesmanName)" />
                <GridColumn TItem="DistributionRow" Title="@L10n.T("dist.col_supervisor")"          Value="@(x => x.SalesSupName)" />
                <GridColumn TItem="DistributionRow" Title="SKU Code"    Value="@(x => x.SKUCode)" />
                <GridColumn TItem="DistributionRow" Title="SKU Name"    Value="@(x => x.SKUName)" />
                <GridColumn TItem="DistributionRow" Title="@L10n.T("dist.col_type")"        Value="@(x => x.Type)" Align="center" />
                <GridColumn TItem="DistributionRow" Title="@L10n.T("dist.col_stock_npp")" Value="@(x => x.StockSKU)" Align="end" />
                <GridColumn TItem="DistributionRow" Title="@L10n.T("dist.col_stock_salesman")" Value="@(x => x.StockSalesman)" Align="end" />
                <GridColumn TItem="DistributionRow" Title="@L10n.T("dist.col_distribute_date")" Value="@(x => x.DistributeDate.HasValue ? x.DistributeDate.Value.ToString("dd/MM/yyyy") : "")" Align="center" />
            </Columns>
            <RowTemplate>
                <td class="fw-semibold">@r.SalesmanName <small class="text-muted">(@r.SalesmanCode)</small></td>
                <td class="small text-muted">@r.SalesSupName</td>
                <td class="font-monospace small">@r.SKUCode</td>
                <td>@r.SKUName</td>
                <td class="text-center"><span class="badge bg-secondary">@r.Type</span></td>
                <td class="text-end">@r.StockSKU.ToString("N0")</td>
                <td class="text-end @(r.StockSalesman > 0 ? "text-success fw-bold" : "")">@r.StockSalesman.ToString("N0")</td>
                <td class="text-center small">@(r.DistributeDate.HasValue ? r.DistributeDate.Value.ToString("dd/MM/yyyy") : "-")</td>
            </RowTemplate>
            <ActionColumn Context="r">
                <button class="btn btn-xs btn-outline-danger" title="@L10n.T("btn.delete")" @onclick="()=>DeleteAsync(r)">
                    <i class="bi bi-trash"></i>
                </button>
            </ActionColumn>
        </SortableGrid>
    }
    else if (_searched)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-inbox display-6"></i>
            <p class="mt-2">@L10n.T("dist.no_data_message")</p>
        </div>
    }
</div>

@code {
    private List<DistributionRow> _data = new();
    private List<DistributorRow> _distributors = new();
    private bool _loading, _searched, _ok;
    private string _msg = "", _distCode = "";
    private DateTime _date = DateTime.Today;

    private void ClearMsg() => _msg = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn) { Nav.NavigateTo("/", replace: true); return; }
        _distributors = await DistSvc.GetDistributorsAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true; _searched = false;
        _data = await DistSvc.GetDistributionAsync(_date, _distCode, Auth.UserName);
        _loading = false; _searched = true;
    }

    private async Task DeleteAsync(DistributionRow r)
    {
        var (ok, msg) = await DistSvc.DeleteDistributionAsync(r.SalesmanCode, r.SKUCode, r.DistributorCode);
        _ok = ok; _msg = msg;
        if (ok) _data.Remove(r);
    }
}
