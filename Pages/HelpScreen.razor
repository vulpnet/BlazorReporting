@page "/help/{Screen}"
@using BlazorReporting.Services
@inject LocalizationService L10n
@inject NavigationManager Nav

<PageTitle>@(CurrentDef?.Title ?? Screen) – Help</PageTitle>

@if (CurrentDef is null)
{
    <div class="container-lg py-5 text-center">
        <i class="bi bi-question-circle display-3 text-muted opacity-25"></i>
        <h4 class="mt-3 text-muted">Không tìm thấy hướng dẫn cho màn hình "<code>@Screen</code>"</h4>
        <a href="/help" class="btn btn-outline-primary mt-3"><i class="bi bi-arrow-left me-1"></i>Về trang Help</a>
    </div>
}
else
{
    var d = CurrentDef;
    <div class="container-lg py-4">

        @* ── Hero ── *@
        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
            <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,@d.GradFrom,@d.GradTo);
                        display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex-shrink:0">
                <i class="bi @d.Icon text-white"></i>
            </div>
            <div class="flex-grow-1 min-width-0">
                <h3 class="mb-0 fw-bold">@d.Title</h3>
                <p class="text-muted small mb-0">@d.TitleEn &nbsp;·&nbsp; <code class="small">@d.Route</code></p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a href="@d.Route" class="btn btn-primary btn-sm">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Vào màn hình
                </a>
                <a href="/help#screen-directory" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Danh mục
                </a>
            </div>
        </div>

        @* ── Role badge ── *@
        <div class="mb-4 d-flex align-items-center gap-2 flex-wrap">
            <span class="text-muted small">Quyền truy cập:</span>
            @foreach (var r in d.Roles)
            {
                <span class="badge @(r=="All"?"bg-success":"bg-primary")">@r</span>
            }
        </div>

        @* ── 1. Mô tả ── *@
        <section class="mb-4">
            <h5 class="fw-semibold border-start border-3 border-primary ps-2 mb-3">
                <i class="bi bi-info-circle me-1 text-primary"></i>Mô tả chức năng
                <small class="text-muted fw-normal ms-2">/ Overview</small>
            </h5>
            <div class="card border-0 shadow-sm">
                <div class="card-body">@((MarkupString)d.Description)</div>
            </div>
        </section>

        @* ── 2. Các bước ── *@
        @if (d.Steps.Any())
        {
            <section class="mb-4">
                <h5 class="fw-semibold border-start border-3 border-success ps-2 mb-3">
                    <i class="bi bi-list-ol me-1 text-success"></i>Hướng dẫn sử dụng
                    <small class="text-muted fw-normal ms-2">/ How to use</small>
                </h5>
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <ol class="ps-3 mb-0">
                            @foreach (var step in d.Steps)
                            {
                                <li class="mb-2 small">@((MarkupString)step)</li>
                            }
                        </ol>
                    </div>
                </div>
            </section>
        }

        @* ── 3. Giải thích cột ── *@
        @if (d.Columns.Any())
        {
            <section class="mb-4">
                <h5 class="fw-semibold border-start border-3 border-warning ps-2 mb-3">
                    <i class="bi bi-table me-1 text-warning"></i>Giải thích cột dữ liệu
                    <small class="text-muted fw-normal ms-2">/ Column reference</small>
                </h5>
                <div class="card border-0 shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:180px">Cột / Column</th>
                                    <th>Mô tả / Description</th>
                                    <th style="width:100px" class="text-center">Loại / Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var col in d.Columns)
                                {
                                    <tr>
                                        <td class="fw-semibold small font-monospace">@col.Name</td>
                                        <td class="small">@((MarkupString)col.Desc)</td>
                                        <td class="text-center">
                                            <span class="badge @ColTypeBadge(col.Type)" style="font-size:.62rem">@col.Type</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        }

        @* ── 4. Lưu ý ── *@
        @if (d.Notes.Any())
        {
            <section class="mb-4">
                <h5 class="fw-semibold border-start border-3 border-danger ps-2 mb-3">
                    <i class="bi bi-exclamation-triangle me-1 text-danger"></i>Lưu ý & Cảnh báo
                    <small class="text-muted fw-normal ms-2">/ Notes & warnings</small>
                </h5>
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <ul class="ps-3 mb-0">
                            @foreach (var note in d.Notes)
                            {
                                <li class="mb-2 small">@((MarkupString)note)</li>
                            }
                        </ul>
                    </div>
                </div>
            </section>
        }

        @* ── Footer nav ── *@
        <div class="d-flex gap-2 pt-3 border-top flex-wrap">
            <a href="/help#screen-directory" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-grid-3x3-gap me-1"></i>Danh mục màn hình
            </a>
            <a href="/help" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-book me-1"></i>Trang Help chính
            </a>
            <a href="@d.Route" class="btn btn-primary btn-sm ms-auto">
                <i class="bi bi-box-arrow-up-right me-1"></i>Vào @d.Title
            </a>
        </div>
    </div>
}

