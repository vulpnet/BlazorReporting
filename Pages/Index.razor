@page "/"
@layout LoginLayout
@using BlazorReporting.Shared
@using BlazorReporting.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject AuthService Auth
@inject NavigationManager Nav
@inject ProtectedLocalStorage Store
@inject AuditLogService Audit
@inject DeviceSessionService DeviceSvc
@inject IJSRuntime JS
@inject LocalizationService L10n

<div class="login-page">

    @* ══ CỘT TRÁI — Brand ══════════════════════════════ *@
    <div class="login-brand">
        <div class="login-brand-inner">

            <div class="login-logo">
                <div class="login-logo-icon">
                    <i class="bi bi-bar-chart-line-fill"></i>
                </div>
                <div>
                    <div class="login-logo-name">DMSPRO</div>
                    <div class="login-logo-sub">Reporting</div>
                </div>
            </div>

            <h2 class="login-tagline">
                @((MarkupString)L10n.T("login.tagline"))
            </h2>
            <p class="login-desc">
                @L10n.T("login.desc")
            </p>

            <ul class="login-features">
                <li>
                    <span class="login-feat-icon"><i class="bi bi-database-fill"></i></span>
                    <span>@L10n.T("login.feat_sql")</span>
                </li>
                <li>
                    <span class="login-feat-icon"><i class="bi bi-grid-3x3-gap-fill"></i></span>
                    <span>@L10n.T("login.feat_pivot")</span>
                </li>
                <li>
                    <span class="login-feat-icon"><i class="bi bi-file-earmark-arrow-down-fill"></i></span>
                    <span>@L10n.T("login.feat_export")</span>
                </li>
                <li>
                    <span class="login-feat-icon"><i class="bi bi-geo-alt-fill"></i></span>
                    <span>@L10n.T("login.feat_map")</span>
                </li>
                <li>
                    <span class="login-feat-icon"><i class="bi bi-robot"></i></span>
                    <span>@L10n.T("login.feat_ai")</span>
                </li>
            </ul>

            <div class="login-deco login-deco-1"></div>
            <div class="login-deco login-deco-2"></div>
            <div class="login-deco login-deco-3"></div>
        </div>
    </div>

    @* ══ CỘT PHẢI — Form ═══════════════════════════════ *@
    <div class="login-form-side">
        <div class="login-card">

            <div class="login-card-header">
                <div class="login-card-logo-sm">
                    <i class="bi bi-bar-chart-line-fill"></i>
                </div>
                <h4 class="login-card-title">@L10n.T("login.title")</h4>
                <p class="login-card-sub">@L10n.T("login.subtitle")</p>
            </div>

            @* Language switcher *@
            <div class="login-lang-switcher" style="display:flex;gap:6px;justify-content:center;margin-bottom:12px;">
                <button type="button" class="btn btn-sm @(_currentLang == "VI" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick='() => SetLangAsync("VI")'>VI</button>
                <button type="button" class="btn btn-sm @(_currentLang == "EN" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick='() => SetLangAsync("EN")'>EN</button>
                <button type="button" class="btn btn-sm @(_currentLang == "ID" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick='() => SetLangAsync("ID")'>ID</button>
            </div>

            @if (_error)
            {
                <div class="login-alert">
                    <i class="bi bi-shield-exclamation me-2"></i>
                    @L10n.T("login.error")
                </div>
            }

            <div class="login-fields">

                @* Username *@
                <div class="lf-group @(_focusUser ? "lf-group--focus" : "")">
                    <label class="lf-label">@L10n.T("login.username")</label>
                    <div class="lf-input-wrap">
                        <span class="lf-icon"><i class="bi bi-person-fill"></i></span>
                        <input class="lf-input"
                               type="text"
                               autocomplete="username"
                               spellcheck="false"
                               @bind="_username"
                               @bind:event="oninput"
                               @onfocus="() => _focusUser = true"
                               @onblur="() => _focusUser = false"
                               @onkeydown="OnKeyDown"
                               disabled="@_loading"
                               placeholder="@L10n.T("login.username_placeholder")" />
                    </div>
                </div>

                @* Password *@
                <div class="lf-group @(_focusPass ? "lf-group--focus" : "")">
                    <label class="lf-label">@L10n.T("login.password")</label>
                    <div class="lf-input-wrap">
                        <span class="lf-icon"><i class="bi bi-lock-fill"></i></span>
                        <input class="lf-input"
                               type="@(_showPass ? "text" : "password")"
                               autocomplete="current-password"
                               @bind="_password"
                               @bind:event="oninput"
                               @onfocus="() => _focusPass = true"
                               @onblur="() => _focusPass = false"
                               @onkeydown="OnKeyDown"
                               disabled="@_loading"
                               placeholder="@L10n.T("login.password_placeholder")" />
                        <button class="lf-eye" type="button" tabindex="-1"
                                @onclick="() => _showPass = !_showPass"
                                title="@(_showPass ? L10n.T("login.hide_password") : L10n.T("login.show_password"))">
                            <i class="bi @(_showPass ? "bi-eye-slash" : "bi-eye")"></i>
                        </button>
                    </div>
                </div>

                <button class="lf-submit @(_loading ? "lf-submit--loading" : "")"
                        @onclick="LoginAsync"
                        disabled="@(_loading || string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))">
                    @if (_loading)
                    {
                        <span class="lf-spinner"></span>
                        <span>@L10n.T("login.loading")</span>
                    }
                    else
                    {
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        <span>@L10n.T("login.btn")</span>
                    }
                </button>

            </div>

            <div class="login-card-footer">
                <i class="bi bi-shield-lock me-1"></i>
                @L10n.T("login.secure_note")
            </div>
        </div>

        <div class="login-copyright">
            © @DateTime.Now.Year DMSPRO Reporting — All rights reserved
        </div>
    </div>

</div>

@code {
    private string _username = "";
    private string _password = "";
    private bool   _loading;
    private bool   _error;
    private bool   _showPass;
    private bool   _focusUser;
    private bool   _focusPass;
    private string? _deviceInfo; // S4: thu thap device info
    private string _currentLang = "VI";

    protected override void OnInitialized()
    {
        L10n.OnChanged += () => { _currentLang = L10n.CurrentLang; StateHasChanged(); };
    }

    // Kiểm tra session ngầm sau khi render — không block UI
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Restore saved language
        try
        {
            var saved = await JS.InvokeAsync<string>("localStorage.getItem", "dmspro_lang");
            if (!string.IsNullOrEmpty(saved))
            {
                L10n.SetLang(saved);
                _currentLang = saved;
            }
        }
        catch { }
        // S4: thu thap user agent de identify device
        try { _deviceInfo = await JS.InvokeAsync<string>("eval", "navigator.userAgent"); } catch { }
        try
        {
            var result = await Store.GetAsync<AuthSession>("dmspro_auth");
            if (result.Success && result.Value is not null)
            {
                Auth.Restore(result.Value);
                Nav.NavigateTo("/map", replace: true);
            }
        }
        catch { /* localStorage chưa sẵn sàng hoặc không có session */ }
    }

    private async Task SetLangAsync(string lang)
    {
        L10n.SetLang(lang);
        _currentLang = lang;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "dmspro_lang", lang); } catch { }
        StateHasChanged();
    }

    private async Task LoginAsync()
    {
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password)) return;

        _loading = true;
        _error   = false;
        StateHasChanged();

        await Task.Delay(400);

        var ok = await Auth.LoginAsync(_username, _password);
        _loading = false;

        if (ok)
        {
            Audit.Log(Auth.UserName, AuditLogService.LOGIN, detail: "Login thanh cong",
                      fullName: Auth.FullName, role: Auth.Role); // S3
            // S4: dang ky session, kick session cu neu qua 3 thiet bi
            var sessionId = await DeviceSvc.RegisterSessionAsync(
                Auth.UserName, _deviceInfo, Audit.GetClientIp());
            try
            {
                await Store.SetAsync("dmspro_auth",
                    new AuthSession(Auth.UserName, Auth.FullName, Auth.Role));
                await Store.SetAsync("dmspro_session", sessionId); // luu session ID
            }
            catch { }
            Nav.NavigateTo("/report", replace: true);
        }
        else
        {
            Audit.Log(_username, AuditLogService.LOGIN, detail: "Login that bai", isSuccess: false); // S3
            _error    = true;
            _password = "";
            StateHasChanged();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoginAsync();
    }
}
