@page "/issues/report-usage-app"
@attribute [NavMenu(Title="usage_app.nav_title", Icon="bi-bar-chart-line", Group="nav.issues", GroupOrder=50, Order=50)]
@using BlazorReporting.Services
@inject AuthService Auth
@inject ReportService RptSvc
@inject IExportService ExportSvc
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject LocalizationService L10n
<PageTitle>@L10n.T("usage_app.page_title")</PageTitle>
<div class="container-fluid mt-3">
    <h5 class="mb-3"><i class="bi bi-bar-chart-line me-2"></i>@L10n.T("usage_app.page_title")</h5>
    <div class="card shadow-sm mb-3"><div class="card-body py-2">
        <div class="d-flex gap-2 flex-wrap align-items-end">
            <div>
                <label class="form-label small mb-1">@L10n.T("lbl.from_date")</label>
                <input type="date" class="form-control form-control-sm" style="width:150px" @bind="_from" />
            </div>
            <div>
                <label class="form-label small mb-1">@L10n.T("lbl.to_date")</label>
                <input type="date" class="form-control form-control-sm" style="width:150px" @bind="_to" />
            </div>
            <div>
                <label class="form-label small mb-1">@L10n.T("lbl.distributor")</label>
                <input type="number" class="form-control form-control-sm" style="width:110px" @bind="_distId" />
            </div>
            <div>
                <label class="form-label small mb-1">@L10n.T("usage_app.lbl_role")</label>
                <input class="form-control form-control-sm" style="width:120px" placeholder="RoleID..." @bind="_roleId" />
            </div>
            <button class="btn btn-sm btn-primary" @onclick="LoadAsync">
                <i class="bi bi-search me-1"></i>@L10n.T("btn.view")
            </button>
            @if (_data.Any())
            {
                <button class="btn btn-sm btn-success" @onclick="ExportExcel">
                    <i class="bi bi-file-earmark-excel me-1"></i>Excel
                </button>
                <span class="text-muted small ms-1">@_data.Count @L10n.T("grid.rows_suffix")</span>
            }
        </div>
    </div></div>

    @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger py-2 alert-dismissible">@_error<button class="btn-close" @onclick="()=>_error=string.Empty"></button></div> }
    @if (_loading) { <div class="text-center py-4"><span class="spinner-border text-primary"></span></div> }
    else
    {
        <SortableGrid Items="_data" Context="r" MinWidth="1000px" DefaultPageSize="20">
            <Columns>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.distributor")"       Value="@(x=>x.DistributorName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.salesman")"          Value="@(x=>x.SalesmanName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("usage_app.col_role")"    Value="@(x=>x.RoleName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("usage_app.col_login")"   Value="@(x=>x.Click)" Align="end"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("usage_app.col_page")"    Value="@(x=>x.Page)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.date")"              Value="@(x=>x.VisitDate.HasValue?x.VisitDate.Value.ToString("dd/MM/yyyy"):"")" Align="center"/>
            </Columns>
            <RowTemplate>
                <td class="small">@r.DistributorName</td>
                <td class="fw-semibold small">@r.SalesmanName</td>
                <td class="small">@r.RoleName</td>
                <td class="text-end small">@r.Click</td>
                <td class="small">@r.Page</td>
                <td class="text-center small">@(r.VisitDate.HasValue?r.VisitDate.Value.ToString("dd/MM/yyyy"):"—")</td>
            </RowTemplate>
        </SortableGrid>
    }
</div>

@code {
    private List<GenericReportRow> _data = new();
    private bool _loading; private string _error = "";
    private DateTime _from = DateTime.Today.AddDays(-7), _to = DateTime.Today;
    private int _distId = 0; private string _roleId = "";

    protected override void OnInitialized() { if (!Auth.IsLoggedIn) Nav.NavigateTo("/", replace: true); }

    private async Task LoadAsync()
    {
        _loading = true; _error = "";
        try { _data = await RptSvc.GetReportUsageAppAsync(_from, _to, Auth.UserName, _distId, _roleId); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task ExportExcel()
    {
        var rows = _data.Select(r => new Dictionary<string, object?>
        {
            [L10n.T("lbl.distributor")]      = r.DistributorName,
            [L10n.T("lbl.salesman")]         = r.SalesmanName,
            [L10n.T("usage_app.col_role")]   = r.RoleName,
            [L10n.T("usage_app.col_login")]  = r.Click,
            [L10n.T("usage_app.col_page")]   = r.Page,
            [L10n.T("lbl.date")]             = r.VisitDate?.ToString("dd/MM/yyyy"),
        }).ToList();
        var bytes = await ExportSvc.ToExcelAsync(rows, L10n.T("usage_app.page_title"));
        var b64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadBase64", b64, $"UsageApp_{_from:yyyyMMdd}_{_to:yyyyMMdd}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
}

