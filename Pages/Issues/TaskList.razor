@page "/issues/tasks"
@attribute [NavMenu(Title="task.nav_title", Icon="bi-list-check", Group="nav.issues", GroupOrder=50, Order=20)]
@using BlazorReporting.Services
@inject AuthService Auth
@inject IssuesService IssueSvc
@inject NavigationManager Nav
@inject LocalizationService L10n

<PageTitle>@L10n.T("task.page_title")</PageTitle>

<div class="container-fluid mt-3">
    <h5 class="mb-3"><i class="bi bi-list-check me-2"></i>@L10n.T("task.page_title")</h5>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert @(_ok?"alert-success":"alert-danger") py-2 alert-dismissible">
            @_msg <button class="btn-close" @onclick="ClearMsg"></button>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center py-4"><span class="spinner-border text-primary"></span></div>
    }
    else
    {
        <SortableGrid Items="_data" Context="r" MinWidth="800px" DefaultPageSize="20">
            <ToolbarContent>
                <button class="btn btn-sm btn-primary" @onclick="OpenAdd">
                    <i class="bi bi-plus-lg me-1"></i>@L10n.T("task.btn_create")
                </button>
            </ToolbarContent>
            <Columns>
                <GridColumn TItem="TaskRow" Title="@L10n.T("task.col_ref_nbr")"   Value="@(x => x.RefNbr)" />
                <GridColumn TItem="TaskRow" Title="@L10n.T("task.col_title")"   Value="@(x => x.Title)" />
                <GridColumn TItem="TaskRow" Title="@L10n.T("task.col_assign_to")" Value="@(x => x.ApplyTo)" />
                <GridColumn TItem="TaskRow" Title="@L10n.T("task.col_start_date")"   Value="@(x => x.StartDate.HasValue ? x.StartDate.Value.ToString("dd/MM/yyyy") : "")" Align="center" />
                <GridColumn TItem="TaskRow" Title="@L10n.T("task.col_end_date")"  Value="@(x => x.EndDate.HasValue ? x.EndDate.Value.ToString("dd/MM/yyyy") : "")" Align="center" />
                <GridColumn TItem="TaskRow" Title="@L10n.T("task.col_created_by")"   Value="@(x => x.CreatedByID)" />
                <GridColumn TItem="TaskRow" Title="@L10n.T("task.col_status")" Value="@(x => x.Active ? "Active" : "Inactive")" Align="center" />
            </Columns>
            <RowTemplate>
                <td class="small font-monospace">@r.RefNbr</td>
                <td class="fw-semibold">@r.Title</td>
                <td class="small">@r.ApplyTo</td>
                <td class="text-center small">@(r.StartDate.HasValue ? r.StartDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                <td class="text-center small">@(r.EndDate.HasValue ? r.EndDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                <td class="small text-muted">@r.CreatedByID</td>
                <td class="text-center">
                    <span class="badge @(r.Active?"bg-success":"bg-secondary")">
                        @(r.Active?"Active":"Inactive")
                    </span>
                </td>
            </RowTemplate>
            <ActionColumn Context="r">
                <button class="btn btn-xs btn-outline-primary me-1" @onclick="()=>OpenEdit(r)">
                    <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-xs @(r.Active?"btn-outline-warning":"btn-outline-success")"
                        @onclick="()=>ToggleAsync(r)">
                    <i class="bi @(r.Active?"bi-pause":"bi-play")"></i>
                </button>
            </ActionColumn>
        </SortableGrid>
    }
</div>

@if (_showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_isAdd ? L10n.T("task.modal_title_add") : L10n.T("task.modal_title_edit"))</h5>
                    <button class="btn-close" @onclick="()=>_showModal=false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label class="form-label">@L10n.T("task.lbl_title_required")</label>
                        <input class="form-control" @bind="_fTitle" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@L10n.T("task.lbl_description")</label>
                        <textarea class="form-control" rows="3" @bind="_fDesc"></textarea>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label">@L10n.T("task.col_start_date")</label>
                            <input type="date" class="form-control" @bind="_fStart" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">@L10n.T("task.col_end_date")</label>
                            <input type="date" class="form-control" @bind="_fEnd" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@L10n.T("task.col_assign_to")</label>
                        <select class="form-select" @bind="_fApplyTo">
                            <option value="Seller">@L10n.T("task.option_seller")</option>
                            <option value="AtributeCustomer">@L10n.T("task.option_outlet")</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="()=>_showModal=false">@L10n.T("task.btn_cancel")</button>
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @L10n.T("task.btn_save")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TaskRow> _data = new();
    private bool _loading = true, _showModal, _saving, _ok, _isAdd;
    private string _msg = "", _fTitle = "", _fDesc = "", _fApplyTo = "Seller", _fRefNbr = "";
    private DateTime _fStart = DateTime.Today, _fEnd = DateTime.Today.AddDays(7);

    private void ClearMsg() => _msg = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn) { Nav.NavigateTo("/", replace: true); return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _data = await IssueSvc.GetTasksAsync();
        _loading = false;
    }

    private void OpenAdd()
    {
        _isAdd = true; _fRefNbr = ""; _fTitle = ""; _fDesc = ""; _fApplyTo = "Seller";
        _fStart = DateTime.Today; _fEnd = DateTime.Today.AddDays(7);
        _showModal = true;
    }

    private void OpenEdit(TaskRow r)
    {
        _isAdd = false; _fRefNbr = r.RefNbr; _fTitle = r.Title; _fDesc = r.Desc;
        _fApplyTo = r.ApplyTo;
        _fStart = r.StartDate ?? DateTime.Today;
        _fEnd   = r.EndDate   ?? DateTime.Today.AddDays(7);
        _showModal = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_fTitle)) { _ok=false; _msg=L10n.T("task.err_title_required"); return; }
        _saving = true;
        var row = new TaskRow { RefNbr=_fRefNbr, Title=_fTitle, Desc=_fDesc, ApplyTo=_fApplyTo, StartDate=_fStart, EndDate=_fEnd, CreatedByID=Auth.UserName };
        if (_isAdd)
        {
            var refNbr = await IssueSvc.CreateTaskAsync(row, Auth.UserName);
            row.RefNbr = refNbr; row.Active = true; row.CreatedDateTime = DateTime.Now;
            _data.Insert(0, row);
            _ok = true; _msg = L10n.T("task.msg_create_success").Replace("{refNbr}", refNbr);
        }
        else
        {
            var ok = await IssueSvc.UpdateTaskAsync(row);
            _ok = ok; _msg = ok ? L10n.T("task.msg_update_success") : L10n.T("task.msg_update_error");
            if (ok) { var idx=_data.FindIndex(x=>x.RefNbr==_fRefNbr); if(idx>=0) { _data[idx].Title=_fTitle; _data[idx].Desc=_fDesc; } }
        }
        _saving = false; _showModal = false;
    }

    private async Task ToggleAsync(TaskRow r)
    {
        var ok = await IssueSvc.ToggleTaskActiveAsync(r.RefNbr, !r.Active);
        if (ok) { var idx=_data.FindIndex(x=>x.RefNbr==r.RefNbr); if(idx>=0) _data[idx].Active=!r.Active; }
    }
}


