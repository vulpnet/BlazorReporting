@page "/report/outlet-not-visit-mcp"
@attribute [NavMenu(Title="report.outlet_not_visit_mcp.title", Icon="bi-shop-window", Group="nav.reports", GroupOrder=20, Order=140)]
@using BlazorReporting.Services
@inject AuthService Auth
@inject ReportService RptSvc
@inject NavigationManager Nav
@inject LocalizationService L10n
<PageTitle>@L10n.T("report.outlet_not_visit_mcp.title")</PageTitle>
<div class="container-fluid mt-3">
    <h5 class="mb-3"><i class="bi bi-shop-window me-2 text-danger"></i>@L10n.T("report.outlet_not_visit_mcp.title")</h5>
    <div class="card shadow-sm mb-3"><div class="card-body py-2">
        <div class="d-flex gap-2 flex-wrap align-items-end">
            <div><label class="form-label small mb-1">@L10n.T("lbl.date")</label><input type="date" class="form-control form-control-sm" style="width:150px" @bind="_date"/></div>
            <div><label class="form-label small mb-1">@L10n.T("lbl.route")</label><input class="form-control form-control-sm" style="width:150px" placeholder="@L10n.T("report.outlet_not_visit_mcp.placeholder_route")" @bind="_route"/></div>
            <div><label class="form-label small mb-1">@L10n.T("lbl.supervisor")</label><input class="form-control form-control-sm" style="width:140px" placeholder="@L10n.T("report.outlet_not_visit_mcp.placeholder_supervisor")" @bind="_sup"/></div>
            <button class="btn btn-sm btn-primary" @onclick="LoadAsync"><i class="bi bi-search me-1"></i>@L10n.T("btn.view")</button>
            @if (_data.Any()){<span class="text-muted small ms-2">@L10n.T("report.outlet_not_visit_mcp.row_count")</span>}
        </div>
    </div></div>
    @if (_error!=null){<div class="alert alert-danger py-2 alert-dismissible">@_error<button class="btn-close" @onclick="ClearErr"></button></div>}
    @if (_loading){<div class="text-center py-4"><span class="spinner-border text-primary"></span></div>}
    else {
        <SortableGrid Items="_data" Context="r" MinWidth="900px" DefaultPageSize="20">
            <Columns>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("report.outlet_not_visit_mcp.col_salesman")"         Value="@(x=>x.SalesmanName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.route")"       Value="@(x=>x.RouteCD)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.distributor")" Value="@(x=>x.DistributorName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("report.outlet_not_visit_mcp.col_outlet_id")"   Value="@(x=>x.OutletID)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("report.outlet_not_visit_mcp.col_outlet_name")" Value="@(x=>x.OutletName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.supervisor")"          Value="@(x=>x.SalesSupName)"/>
            </Columns>
            <RowTemplate>
                <td class="fw-semibold small">@r.SalesmanName</td>
                <td class="small font-monospace">@r.RouteCD</td>
                <td class="small">@r.DistributorName</td>
                <td class="small font-monospace text-danger">@r.OutletID</td>
                <td class="small">@r.OutletName</td>
                <td class="small text-muted">@r.SalesSupName</td>
            </RowTemplate>
        </SortableGrid>
    }
</div>
@code {
    private List<GenericReportRow> _data=new(); private bool _loading; private string? _error;
    private string _route="",_sup=""; private DateTime _date=DateTime.Today;
    private void ClearErr() => _error = null;
    protected override void OnInitialized(){if(!Auth.IsLoggedIn)Nav.NavigateTo("/",replace:true);}
    private async Task LoadAsync(){_loading=true;_error=null;
        try{_data=await RptSvc.GetOutletNotVisitMCPAsync(_date,Auth.UserName,sup:_sup,route:_route);}
        catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}
}
