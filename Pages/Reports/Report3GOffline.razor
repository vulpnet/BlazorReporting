@page "/report/3g-offline"
@attribute [NavMenu(Title="Báo cáo 3G Offline", Icon="bi-wifi-off", Group="Báo cáo", GroupOrder=20, Order=80)]
@using BlazorReporting.Services
@inject AuthService Auth
@inject ReportService RptSvc
@inject NavigationManager Nav
<PageTitle>3G Offline</PageTitle>
<div class="container-fluid mt-3">
    <h5 class="mb-3"><i class="bi bi-wifi-off me-2"></i>Bao cao Nhân viên BH Offline 3G</h5>
    <div class="card shadow-sm mb-3"><div class="card-body py-2">
        <div class="d-flex gap-2 flex-wrap align-items-end">
            <div><label class="form-label small mb-1">Từ ngày</label><input type="date" class="form-control form-control-sm" style="width:150px" @bind="_from"/></div>
            <div><label class="form-label small mb-1">Đến ngày</label><input type="date" class="form-control form-control-sm" style="width:150px" @bind="_to"/></div>
            <div><label class="form-label small mb-1">Tuyến</label><input class="form-control form-control-sm" style="width:150px" @bind="_route"/></div>
            <button class="btn btn-sm btn-primary" @onclick="LoadAsync"><i class="bi bi-search me-1"></i>Xem</button>
            @if (_data.Any()){<span class="text-muted small ms-2">@_data.Count dong</span>}
        </div>
    </div></div>
    @if (_error!=null){<div class="alert alert-danger py-2 alert-dismissible">@_error<button class="btn-close" @onclick="ClearErr"></button></div>}
    @if (_loading){<div class="text-center py-4"><span class="spinner-border text-primary"></span></div>}
    else {
        <SortableGrid Items="_data" Context="r" MinWidth="900px" DefaultPageSize="20">
            <Columns>
                <GridColumn TItem="GenericReportRow" Title="Nhân viên BH"         Value="@(x=>x.SalesmanName)"/>
                <GridColumn TItem="GenericReportRow" Title="Giám sát"          Value="@(x=>x.SalesSupName)"/>
                <GridColumn TItem="GenericReportRow" Title="Tuyến"       Value="@(x=>x.RouteCD)"/>
                <GridColumn TItem="GenericReportRow" Title="NPP" Value="@(x=>x.DistributorName)"/>
                <GridColumn TItem="GenericReportRow" Title="Ngày"        Value="@(x=>x.VisitDate.HasValue?x.VisitDate.Value.ToString("dd/MM/yyyy"):"")" Align="center"/>
                <GridColumn TItem="GenericReportRow" Title="Thời gian (ph)" Value="@(x=>x.ActualTime)" Align="end"/>
                <GridColumn TItem="GenericReportRow" Title="Giới hạn"    Value="@(x=>x.TimeLimit)" Align="end"/>
                <GridColumn TItem="GenericReportRow" Title="Kết quả"     Value="@(x=>x.Evaluate)" Align="center"/>
            </Columns>
            <RowTemplate>
                <td class="fw-semibold small">@r.SalesmanName</td>
                <td class="small text-muted">@r.SalesSupName</td>
                <td class="small font-monospace">@r.RouteCD</td>
                <td class="small">@r.DistributorName</td>
                <td class="text-center small">@(r.VisitDate.HasValue?r.VisitDate.Value.ToString("dd/MM/yyyy"):"-")</td>
                <td class="text-end">@r.ActualTime ph</td>
                <td class="text-end">@r.TimeLimit ph</td>
                <td class="text-center">
                    <span class="badge @(r.Evaluate==1?"bg-success":"bg-danger")">
                        @(r.Evaluate==1?"Dat":"Khong dat")
                    </span>
                </td>
            </RowTemplate>
        </SortableGrid>
    }
</div>
@code {
    private List<GenericReportRow> _data=new(); private bool _loading; private string? _error;
    private string _route=""; private DateTime _from=DateTime.Today.AddDays(-7), _to=DateTime.Today;
    private void ClearErr() => _error = null;
    protected override void OnInitialized(){if(!Auth.IsLoggedIn)Nav.NavigateTo("/",replace:true);}
    private async Task LoadAsync(){_loading=true;_error=null;
        try{_data=await RptSvc.GetReport3GOfflineAsync(_from,_to,Auth.UserName,route:_route);}
        catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}
}
