@page "/report/visit-distance"
@attribute [NavMenu(Title="visit_dist.nav_title", Icon="bi-signpost-split", Group="nav.reports", GroupOrder=20, Order=210)]
@using BlazorReporting.Services
@inject AuthService Auth
@inject ReportService RptSvc
@inject IExportService ExportSvc
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject LocalizationService L10n
<PageTitle>@L10n.T("visit_dist.page_title")</PageTitle>
<div class="container-fluid mt-3">
    <h5 class="mb-3"><i class="bi bi-signpost-split me-2"></i>@L10n.T("visit_dist.page_title")</h5>
    <div class="card shadow-sm mb-3"><div class="card-body py-2">
        <div class="d-flex gap-2 flex-wrap align-items-end">
            <div><label class="form-label small mb-1">@L10n.T("lbl.from_date")</label><input type="date" class="form-control form-control-sm" style="width:150px" @bind="_from"/></div>
            <div><label class="form-label small mb-1">@L10n.T("lbl.to_date")</label><input type="date" class="form-control form-control-sm" style="width:150px" @bind="_to"/></div>
            <div><label class="form-label small mb-1">@L10n.T("lbl.distributor")</label><input type="number" class="form-control form-control-sm" style="width:110px" @bind="_distId"/></div>
            <div><label class="form-label small mb-1">@L10n.T("lbl.supervisor")</label><input class="form-control form-control-sm" style="width:120px" @bind="_sup"/></div>
            <div><label class="form-label small mb-1">@L10n.T("lbl.salesman")</label><input class="form-control form-control-sm" style="width:120px" @bind="_salesmanId"/></div>
            <button class="btn btn-sm btn-primary" @onclick="LoadAsync"><i class="bi bi-search me-1"></i>@L10n.T("btn.view")</button>
            @if (_data.Any()) { <button class="btn btn-sm btn-success" @onclick="ExportExcel"><i class="bi bi-file-earmark-excel me-1"></i>Excel</button> <span class="text-muted small ms-1">@_data.Count dÃ²ng</span> }
        </div>
    </div></div>
    @if (_error != null) { <div class="alert alert-danger py-2 alert-dismissible">@_error<button class="btn-close" @onclick="()=>_error=null"></button></div> }
    @if (_loading) { <div class="text-center py-4"><span class="spinner-border text-primary"></span></div> }
    else {
        <SortableGrid Items="_data" Context="r" MinWidth="1000px" DefaultPageSize="20">
            <Columns>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.distributor")"      Value="@(x=>x.DistributorName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.supervisor")"      Value="@(x=>x.SalesSupName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.route")"           Value="@(x=>x.RouteCD)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.salesman")"        Value="@(x=>x.SalesmanName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.outlet")"          Value="@(x=>x.OutletName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.date")"            Value="@(x=>x.VisitDate.HasValue?x.VisitDate.Value.ToString("dd/MM/yy"):"")" Align="center"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("visit_dist.col_distance")" Value="@(x=>x.VisitDistance.ToString("N0"))" Align="end"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("visit_dist.col_total")"    Value="@(x=>x.TotalDistance.ToString("N0"))" Align="end"/>
            </Columns>
            <RowTemplate>
                <td class="small">@r.DistributorName</td>
                <td class="small">@r.SalesSupName</td>
                <td class="small font-monospace">@r.RouteCD</td>
                <td class="fw-semibold small">@r.SalesmanName</td>
                <td class="small">@r.OutletName</td>
                <td class="text-center small">@(r.VisitDate.HasValue?r.VisitDate.Value.ToString("dd/MM/yy"):"â€”")</td>
                <td class="text-end small">@r.VisitDistance.ToString("N0")</td>
                <td class="text-end small">@r.TotalDistance.ToString("N0")</td>
            </RowTemplate>
        </SortableGrid>
    }
</div>
@code {
    private List<GenericReportRow> _data = new(); private bool _loading; private string? _error;
    private DateTime _from = DateTime.Today.AddDays(-7), _to = DateTime.Today;
    private string _sup="",_salesmanId=""; private int _distId=0;
    protected override void OnInitialized() { if (!Auth.IsLoggedIn) Nav.NavigateTo("/", replace: true); }
    private async Task LoadAsync() { _loading=true;_error=null; try { _data=await RptSvc.GetReportVisitDistanceAsync(_from,_to,Auth.UserName,_distId,_sup,_salesmanId); } catch(Exception ex){_error=ex.Message;} finally{_loading=false;} }
    private async Task ExportExcel() {
        var rows=_data.Select(r=>new Dictionary<string,object?>{["NPP"]=r.DistributorName,["Supervisor"]=r.SalesSupName,["Route"]=r.RouteCD,["Salesman"]=r.SalesmanName,["Outlet"]=r.OutletName,["NgÃ y"]=r.VisitDate?.ToString("dd/MM/yyyy"),["Khoáº£ng cÃ¡ch (m)"]=r.VisitDistance,["Tá»•ng KCÃ¡ch"]=r.TotalDistance}).ToList();
        var bytes=await ExportSvc.ToExcelAsync(rows,"Khoáº£ng cÃ¡ch viáº¿ng thÄƒm");
        await JS.InvokeVoidAsync("downloadBase64",Convert.ToBase64String(bytes),$"VisitDistance_{_from:yyyyMMdd}_{_to:yyyyMMdd}.xlsx","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }
}


