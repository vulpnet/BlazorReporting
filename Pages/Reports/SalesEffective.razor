@page "/report/sales-effective"
@attribute [NavMenu(Title="sales_effective.nav_title", Icon="bi-check2-circle", Group="nav.reports", GroupOrder=20, Order=40)]
@using BlazorReporting.Services
@inject AuthService Auth
@inject ReportService RptSvc
@inject NavigationManager Nav
@inject LocalizationService L10n
<PageTitle>@L10n.T("sales_effective.page_title")</PageTitle>
<div class="container-fluid mt-3">
    <h5 class="mb-3"><i class="bi bi-check2-circle me-2"></i>@L10n.T("sales_effective.heading")</h5>
    <div class="card shadow-sm mb-3"><div class="card-body py-2">
        <div class="d-flex gap-2 flex-wrap align-items-end">
            <div><label class="form-label small mb-1">@L10n.T("lbl.date")</label><input type="date" class="form-control form-control-sm" style="width:150px" @bind="_date"/></div>
            <div><label class="form-label small mb-1">@L10n.T("lbl.route")</label><input class="form-control form-control-sm" style="width:150px" @bind="_route"/></div>
            <div><label class="form-label small mb-1">@L10n.T("lbl.supervisor")</label><input class="form-control form-control-sm" style="width:140px" @bind="_sup"/></div>
            <button class="btn btn-sm btn-primary" @onclick="LoadAsync"><i class="bi bi-search me-1"></i>@L10n.T("btn.view")</button>
        </div>
    </div></div>
    @if (_error!=null){<div class="alert alert-danger py-2 alert-dismissible">@_error<button class="btn-close" @onclick="ClearErr"></button></div>}
    @if (_loading){<div class="text-center py-4"><span class="spinner-border text-primary"></span></div>}
    else {
        <SortableGrid Items="_data" Context="r" MinWidth="900px" DefaultPageSize="20">
            <Columns>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("sales_effective.col_salesman")"        Value="@(x=>x.SalesmanName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.route")"      Value="@(x=>x.RouteCD)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("lbl.distributor")" Value="@(x=>x.DistributorName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("sales_effective.col_outlet_plan")"   Value="@(x=>x.OutletMustVisit)" Align="end"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("sales_effective.col_outlet_visited")"      Value="@(x=>x.OutletVisited)" Align="end"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("sales_effective.col_order_count")"   Value="@(x=>x.OrderCount)" Align="end"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("sales_effective.col_revenue")"   Value="@(x=>x.TotalAmount)" Align="end"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("sales_effective.col_visit_pct")"   Value="@(x=>x.VisitMCP)" Align="end"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("sales_effective.col_so_pct")"   Value="@(x=>x.SOMCP)" Align="end"/>
                <GridColumn TItem="GenericReportRow" Title="LPPC"       Value="@(x=>x.LPPC)" Align="end"/>
            </Columns>
            <RowTemplate>
                <td class="fw-semibold small">@r.SalesmanName</td>
                <td class="small font-monospace">@r.RouteCD</td>
                <td class="small">@r.DistributorName</td>
                <td class="text-end">@r.OutletMustVisit</td>
                <td class="text-end">@r.OutletVisited</td>
                <td class="text-end">@r.OrderCount</td>
                <td class="text-end small">@((r.TotalAmount/1_000_000m).ToString("N2"))M</td>
                <td class="text-end"><span class="@P(r.VisitMCP)">@r.VisitMCP.ToString("N1")%</span></td>
                <td class="text-end small">@r.SOMCP.ToString("N1")%</td>
                <td class="text-end small">@r.LPPC.ToString("N1")</td>
            </RowTemplate>
        </SortableGrid>
    }
</div>
@code {
    private List<GenericReportRow> _data=new(); private bool _loading; private string? _error;
    private string _route="",_sup=""; private DateTime _date=DateTime.Today;
    private void ClearErr() => _error = null;
    private string P(decimal p)=>p>=80?"text-success":p>=50?"text-warning":"text-danger";
    protected override void OnInitialized(){if(!Auth.IsLoggedIn)Nav.NavigateTo("/",replace:true);}
    private async Task LoadAsync(){_loading=true;_error=null;
        try{_data=await RptSvc.GetSalesEffectiveAsync(_date,Auth.UserName,sup:_sup,route:_route);}
        catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}
}
