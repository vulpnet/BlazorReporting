@page "/report/visit-reason"
@attribute [NavMenu(Title="visit_reason.nav_title", Icon="bi-chat-square-text", Group="nav.reports", GroupOrder=20, Order=130)]
@using BlazorReporting.Services
@inject AuthService Auth
@inject ReportService RptSvc
@inject NavigationManager Nav
@inject LocalizationService L10n
<PageTitle>@L10n.T("visit_reason.page_title")</PageTitle>
<div class="container-fluid mt-3">
    <h5 class="mb-3"><i class="bi bi-chat-square-text me-2"></i>@L10n.T("visit_reason.heading")</h5>
    <div class="card shadow-sm mb-3"><div class="card-body py-2">
        <div class="d-flex gap-2 flex-wrap align-items-end">
            <div><label class="form-label small mb-1">@L10n.T("lbl.from_date")</label><input type="date" class="form-control form-control-sm" style="width:150px" @bind="_from"/></div>
            <div><label class="form-label small mb-1">@L10n.T("lbl.to_date")</label><input type="date" class="form-control form-control-sm" style="width:150px" @bind="_to"/></div>
            <div><label class="form-label small mb-1">@L10n.T("lbl.route")</label><input class="form-control form-control-sm" style="width:150px" placeholder="@L10n.T("visit_reason.placeholder_route")" @bind="_route"/></div>
            <div><label class="form-label small mb-1">@L10n.T("lbl.supervisor")</label><input class="form-control form-control-sm" style="width:140px" placeholder="@L10n.T("visit_reason.placeholder_supervisor")" @bind="_sup"/></div>
            <button class="btn btn-sm btn-primary" @onclick="LoadAsync"><i class="bi bi-search me-1"></i>@L10n.T("btn.view")</button>
            @if (_data.Any()){<span class="text-muted small ms-2">@_data.Count @L10n.T("visit_reason.row_count_suffix")</span>}
        </div>
    </div></div>
    @if (_error!=null){<div class="alert alert-danger py-2 alert-dismissible">@_error<button class="btn-close" @onclick="ClearErr"></button></div>}
    @if (_loading){<div class="text-center py-4"><span class="spinner-border text-primary"></span></div>}
    else {
        <SortableGrid Items="_data" Context="r" MinWidth="900px" DefaultPageSize="20">
            <Columns>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("visit_reason.col_salesman")"         Value="@(x=>x.SalesmanName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("visit_reason.col_route")"       Value="@(x=>x.RouteCD)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("visit_reason.col_distributor")" Value="@(x=>x.DistributorName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("visit_reason.col_outlet")"      Value="@(x=>x.OutletName)"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("visit_reason.col_date")"        Value="@(x=>x.VisitDate.HasValue?x.VisitDate.Value.ToString("dd/MM/yyyy"):"")" Align="center"/>
                <GridColumn TItem="GenericReportRow" Title="@L10n.T("visit_reason.col_reason")"       Value="@(x=>x.Reason)"/>
            </Columns>
            <RowTemplate>
                <td class="fw-semibold small">@r.SalesmanName</td>
                <td class="small font-monospace">@r.RouteCD</td>
                <td class="small">@r.DistributorName</td>
                <td class="small">@r.OutletName</td>
                <td class="text-center small">@(r.VisitDate.HasValue?r.VisitDate.Value.ToString("dd/MM/yyyy"):"—")</td>
                <td class="small">@r.Reason</td>
            </RowTemplate>
        </SortableGrid>
    }
</div>
@code {
    private List<GenericReportRow> _data=new(); private bool _loading; private string? _error;
    private string _route="",_sup=""; private DateTime _from=DateTime.Today.AddDays(-7), _to=DateTime.Today;
    private void ClearErr() => _error = null;
    protected override void OnInitialized(){if(!Auth.IsLoggedIn)Nav.NavigateTo("/",replace:true);}
    private async Task LoadAsync(){_loading=true;_error=null;
        try{_data=await RptSvc.GetVisitReasonAsync(_from,_to,Auth.UserName,sup:_sup,route:_route);}
        catch(Exception ex){_error=ex.Message;}finally{_loading=false;}}
}
