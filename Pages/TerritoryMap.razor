    private async Task LoadPsTrendAsync()
    {
        if (string.IsNullOrEmpty(_psSelectedProd)) return;
        _psTrendLoading = true; _psTrendNeedsDraw = false; _psPredictions = [];
        StateHasChanged();
        try
        {
            _psTrendPoints = await Repo.GetProductTrendAsync([_psSelectedProd], 13);
            if (_psTrendPoints.Count > 0)
            {
                _psForecast    = await Task.Run(() => Forecaster.Forecast(_psTrendPoints, 3));
                _psPredictions = BuildPsPredictions(_psForecast);
                _psTrendNeedsDraw = true;
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _psTrendLoading = false; StateHasChanged(); }
    }

    private void RebuildPsCache()
    {
        _psProductNames = _psData.GroupBy(d => d.InventoryCD).ToDictionary(g => g.Key, g => g.First().InventoryName);
        if (_psData.Count == 0) { _psStrategyRowsCache = []; return; }
        bool byAmount = _psMetric == "amount";
        var areaRank = _psData.GroupBy(d => d.AreaLabel)
            .OrderByDescending(g => g.Sum(d => byAmount ? (double)d.TotalAmount : d.TotalQty))
            .Select((g, i) => (g.Key, i)).ToDictionary(x => x.Key, x => x.i);
        int total = areaRank.Count;
        _psStrategyRowsCache = _psData.GroupBy(d => d.AreaLabel).Select(g =>
        {
            var top  = g.OrderByDescending(d => byAmount ? (double)d.TotalAmount : d.TotalQty).First();
            var rank = areaRank.TryGetValue(g.Key, out var r) ? r : 0;
            var name = top.InventoryName;
            string tc, ti, tt, sg;
            if (rank <= 1)
            {
                tc = "up";   ti = "bi-arrow-up-circle-fill";   tt = "Tăng trưởng";
                sg = "Đẩy mạnh " + name;
            }
            else if (rank >= total - 2)
            {
                tc = "down"; ti = "bi-arrow-down-circle-fill"; tt = "Cần chú ý";
                sg = "Khuyến mãi " + name;
            }
            else
            {
                tc = "flat"; ti = "bi-dash-circle-fill";       tt = "Ổn định";
                sg = "Mở rộng " + name;
            }
            return new PsStrategyRow(g.Key, top.InventoryCD, top.InventoryName,
                g.Sum(d => d.TotalQty), g.Sum(d => d.TotalAmount), tc, ti, tt, sg);
        }).OrderByDescending(r => byAmount ? (double)r.Amount : r.Qty).ToList();
    }

    private static List<PsPrediction> BuildPsPredictions(ForecastResult fc)
    {
        var result = new List<PsPrediction>();
        for (int i = 0; i < fc.Labels.Count; i++)
        {
            var predQ = (long)fc.Qty.Predicted[i];
            var predA = (decimal)fc.Amount.Predicted[i];
            var loQ   = (long)fc.Qty.Lower[i];
            var hiQ   = (long)fc.Qty.Upper[i];
            var sig   = predQ > hiQ * 0.9f ? "up" : predQ < loQ * 1.1f ? "down" : "flat";
            if (i > 0)
            {
                var prev = (long)fc.Qty.Predicted[i-1];
                if (predQ > prev * 1.03f) sig = "up";
                else if (predQ < prev * 0.97f) sig = "down";
                else sig = "flat";
            }
            string icon, txt;
            if (sig == "up")       { icon = "bi-arrow-up-right-circle-fill";   txt = "Tăng"; }
            else if (sig == "down"){ icon = "bi-arrow-down-right-circle-fill"; txt = "Giảm"; }
            else                   { icon = "bi-dash-circle-fill";              txt = "Ổn định"; }
            result.Add(new PsPrediction(fc.Labels[i], predQ, predA, sig, icon, txt));
        }
        return result;
    }

