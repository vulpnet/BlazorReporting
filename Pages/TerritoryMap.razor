    private async Task SelectTreeNodeAsync(string? filterType, string? filterId, string? label)
    {
        _showTreeFilter    = false;
        _selectedTreeType  = filterType;
        _selectedTreeId    = filterId;
        _selectedTreeLabel = label;

        if (filterType == null)
        {
            await JS.InvokeVoidAsync("territoryMapInterop.filterMarkers", (string?)null);
            StateHasChanged();
            return;
        }

        // Filter client-side từ _smGroups — không cần query DB
        var matched = _smGroups
            .Where(kv => filterType switch {
                "stlvl0"      => kv.Value.Stlvl0 == filterId,
                "stlvl1"      => kv.Value.Stlvl1 == filterId,
                "stlvl2"      => kv.Value.Stlvl2 == filterId,
                "ss"          => kv.Value.SsId   == filterId,
                "distributor" => kv.Value.DistId  == filterId,
                "route"       => kv.Value.RouteId == filterId,
                _             => false
            })
            .Select(kv => kv.Key)
            .ToList();

        if (matched.Count == 0)
        {
            await JS.InvokeVoidAsync("territoryMapInterop.filterMarkers", (string?)null);
            _error = $"Không có SM cho: {label}";
            StateHasChanged();
            return;
        }

        var names = JsonSerializer.Serialize(matched);
        await JS.InvokeVoidAsync("territoryMapInterop.filterMarkers", names);
        StateHasChanged();
    }

