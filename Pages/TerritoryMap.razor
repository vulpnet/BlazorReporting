    private static string FormatMoney(decimal v) => v switch
    {
        >= 1_000_000_000 => (v/1_000_000_000m).ToString("F1") + " tỷ",
        >= 1_000_000     => (v/1_000_000m).ToString("F1") + " triệu",
        >= 1_000         => (v/1_000m).ToString("F1") + " nghìn",
        _                => v.ToString("N0")
    };

    private static string AvatarText(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var letters = name.Where(char.IsLetterOrDigit).TakeLast(2).ToArray();
        return letters.Length > 0 ? new string(letters).ToUpper() : name[..Math.Min(2, name.Length)].ToUpper();
    }

    private static string CoverageColor(decimal rate) => rate switch
    {
        >= 80 => "#16a34a",
        >= 60 => "#65a30d",
        >= 40 => "#d97706",
        >= 20 => "#dc2626",
        _     => "#991b1b"
    };

    private static double Haversine(double lat1, double lon1, double lat2, double lon2)
    {
        const double R = 6371;
        var dLat = (lat2-lat1)*Math.PI/180;
        var dLon = (lon2-lon1)*Math.PI/180;
        var a = Math.Sin(dLat/2)*Math.Sin(dLat/2)+Math.Cos(lat1*Math.PI/180)*Math.Cos(lat2*Math.PI/180)*Math.Sin(dLon/2)*Math.Sin(dLon/2);
        return R*2*Math.Atan2(Math.Sqrt(a),Math.Sqrt(1-a));
    }

