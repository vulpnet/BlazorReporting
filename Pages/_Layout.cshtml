@using Microsoft.AspNetCore.Components.Web
@namespace BlazorReporting.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="~/" />
    <title>DMSPro Reporting</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="css/bootstrap.min.css" />
    <link rel="stylesheet" href="css/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="css/leaflet.css" />
    <link rel="stylesheet" href="css/report.css" />
    <link rel="stylesheet" href="css/sidebar.css" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()

    <script src="js/bootstrap.bundle.min.js"></script>
    <script src="js/leaflet.js"></script>
    <script src="js/chart.umd.min.js"></script>
    <script src="js/interop.js"></script>
    <script src="js/mapInterop.js"></script>
    <script src="js/chartInterop.js"></script>
    <script src="js/productChartInterop.js"></script>
    <script src="js/strategyChartInterop.js"></script>
    <script src="js/territoryMapInterop.js"></script>
    <script src="js/dashboardChartInterop.js"></script>
    <script src="js/sessionInterop.js"></script>
    <script src="_framework/blazor.server.js"></script>

    @* Circuit disconnect overlay — hiện khi mất kết nối, không crash app *@
    <div id="blazor-error-ui"
         style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:99999;
                display:none;align-items:center;justify-content:center">
        <div style="background:#fff;border-radius:8px;padding:2rem;max-width:420px;width:90%;text-align:center;box-shadow:0 8px 32px rgba(0,0,0,.3)">
            <i class="bi bi-wifi-off" style="font-size:2.5rem;color:#dc3545"></i>
            <h5 class="mt-3 mb-2">Mat ket noi</h5>
            <p class="text-muted small mb-3">Ket noi den may chu bi gian doan. Vui long tai lai trang.</p>
            <a href="" class="btn btn-danger me-2">
                <i class="bi bi-arrow-clockwise me-1"></i>Tai lai
            </a>
            <button onclick="document.getElementById('blazor-error-ui').style.display='none'"
                    class="btn btn-outline-secondary">
                Dong
            </button>
        </div>
    </div>
    <script>
        // Override Blazor error UI to show centered overlay
        document.addEventListener('DOMContentLoaded', () => {
            const ui = document.getElementById('blazor-error-ui');
            if (ui) ui.style.display = 'none';
        });
    </script>
</body>
</html>
