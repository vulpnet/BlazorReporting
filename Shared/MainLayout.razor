@inherits LayoutComponentBase
@using BlazorReporting.Services
@using BlazorReporting.Data
@using BlazorReporting.Data.Models
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using BlazorReporting.Components
@inject AuthService Auth
@inject NavigationManager Nav
@inject ProtectedLocalStorage Store
@inject IDataRepository Repo
@inject NavMenuService MenuSvc
@inject SessionSecurityService SessionSec
@inject AuditLogService Audit
@inject LocalizationService L10n
@inject IJSRuntime JS
@implements IDisposable

@if (!Auth.IsInitialized)
{
    <div style="min-height:100vh;background:#f1f5f9"></div>
}
else if (!Auth.IsLoggedIn)
{
    Nav.NavigateTo("/", forceLoad: false);
}
else
{
    <CascadingValue Value="L10n" IsFixed="false">
    <div class="dm-shell @(_collapsed ? "is-collapsed" : "") @(_mobileOpen ? "is-mobile-open" : "")">

        <Sidebar Collapsed="_collapsed" CollapsedChanged="OnCollapsedChanged" OnLogout="LogoutAsync" />

        <div class="dm-shell__main">

            <header class="dm-topbar">
                <button class="dm-topbar__toggle dm-only-desktop" @onclick="ToggleCollapse"
                        title="@(_collapsed ? L10n.T("topbar.expand_menu") : L10n.T("topbar.collapse_menu"))">
                    <i class="bi @(_collapsed ? "bi-chevron-double-right" : "bi-chevron-double-left")"></i>
                </button>
                <button class="dm-topbar__toggle dm-only-mobile" @onclick="() => _mobileOpen = !_mobileOpen"
                        title="Menu">
                    <i class="bi bi-list"></i>
                </button>

                <div class="dm-topbar__title">
                    <span class="dm-topbar__crumb">@CurrentGroup</span>
                    @CurrentTitle
                </div>

                @* Language switcher *@
                <div class="d-flex gap-1 align-items-center me-1">
                    @foreach (var lang in new[]{ ("VI","🇻🇳"), ("EN","🇬🇧"), ("ID","🇮🇩") })
                    {
                        var code = lang.Item1; var flag = lang.Item2;
                        <button class="btn btn-xs @(L10n.CurrentLang==code ? "btn-primary" : "btn-light border")"
                                style="font-size:.72rem;padding:2px 6px;min-width:36px"
                                title="@L10n.T("lang."+code)"
                                @onclick="() => SwitchLang(code)">
                            @flag
                        </button>
                    }
                </div>

                <a class="btn btn-sm btn-light border" href="/help" target="_blank" title="@L10n.T("topbar.guide")">
                    <i class="bi bi-question-circle"></i>
                </a>
            </header>

            <main class="dm-content">
                <AppErrorBoundary @ref="_errorBoundary">
                    @Body
                </AppErrorBoundary>
            </main>

            <footer class="dm-footer">
                DMSPRO Reporting &copy; @DateTime.Now.Year &middot; v1.0
            </footer>
        </div>
    </div>
    </CascadingValue>

    <ChatWindow @ref="_chatWindow" ReportLinks="@_reportLinks" />
}

<div id="blazor-error-ui" class="alert alert-danger m-2"
     style="display:none;position:fixed;bottom:1rem;left:1rem;right:1rem;z-index:9999">
    @L10n.T("error.occurred") <a href="" class="alert-link">@L10n.T("error.reload")</a>
</div>

@code {
    private IReadOnlyList<ChatNavLink> _reportLinks = [];
    private bool _collapsed;
    private bool _mobileOpen;
    private AppErrorBoundary? _errorBoundary;
    private DotNetObjectReference<MainLayout>? _jsRef; // S1
    private ChatWindow? _chatWindow;

    private string CurrentTitle => CurrentItem()?.Title ?? L10n.T("nav.home");
    private string CurrentGroup => CurrentItem()?.Group ?? "";

    private NavMenuItem? CurrentItem()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        if (string.IsNullOrEmpty(path)) path = "/";
        return MenuSvc.GetMenu(Auth.Role)
            .SelectMany(g => g.Items)
            .FirstOrDefault(i => string.Equals(i.Href.TrimEnd('/'), path, StringComparison.OrdinalIgnoreCase));
    }

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Auth.OnAuthChanged    += OnAuthChanged;
        L10n.OnChanged        += OnLangChanged;
    }

    // S1: bat dau/dung session monitor khi auth thay doi
    private void OnAuthChanged()
    {
        if (Auth.IsLoggedIn)
        {
            SessionSec.Start();
            // Hien loi chao khi login
            InvokeAsync(async () =>
            {
                await Task.Delay(800); // cho layout render xong
                if (_chatWindow is not null)
                    await _chatWindow.ShowGreetingAsync();
                StateHasChanged();
            });
        }
        else
        {
            SessionSec.Stop();
            InvokeAsync(StateHasChanged);
        }
    }

    // S1: JS goi khi user co hoat dong
    [JSInvokable]
    public void JsRecordActivity() => SessionSec.RecordActivity();

    private void OnLocationChanged(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SessionSec.RecordActivity(); // S1: navigate = hoat dong
        _mobileOpen = false;
        _errorBoundary?.Recover(); // reset lỗi khi navigate sang trang khác
        InvokeAsync(StateHasChanged);
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    private async Task SwitchLang(string lang)
    {
        if (L10n.CurrentLang == lang) return;
        try { await Store.SetAsync("dmspro_lang", lang); } catch { }
        // Force reload dam bao tat ca component cap nhat voi ngon ngu moi
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        Auth.OnAuthChanged  -= OnAuthChanged;
        L10n.OnChanged      -= OnLangChanged;
        // S1: dung JS listener va session monitor
        try { JS.InvokeVoidAsync("sessionInterop.stop"); } catch { }
        _jsRef?.Dispose();
        SessionSec.Stop();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // S1: dang ky JS listener theo doi hoat dong user
        try
        {
            _jsRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("sessionInterop.start", _jsRef);
        }
        catch { /* ignore nếu JS chưa sẵn sàng */ }

        // Restore ngon ngu da luu — phai set truoc khi render cac component con
        try
        {
            var savedLang = await Store.GetAsync<string>("dmspro_lang");
            if (savedLang.Success && !string.IsNullOrEmpty(savedLang.Value)
                && savedLang.Value != L10n.CurrentLang)
            {
                L10n.SetLang(savedLang.Value);
                StateHasChanged(); // re-render topbar voi ngon ngu dung
            }
        }
        catch { }

        if (!Auth.IsInitialized)
        {
            try
            {
                var result = await Store.GetAsync<AuthSession>("dmspro_auth");
                if (result.Success && result.Value is not null)
                    Auth.Restore(result.Value);
                else
                    Auth.MarkInitialized();
            }
            catch { Auth.MarkInitialized(); }

            StateHasChanged();
        }

        // Restore sidebar collapsed pref
        try
        {
            var col = await Store.GetAsync<bool>("dmspro_sidebar_collapsed");
            if (col.Success && col.Value != _collapsed)
            {
                _collapsed = col.Value;
                StateHasChanged();
            }
        }
        catch { }

        _ = LoadReportLinksAsync();
    }

    private async Task OnCollapsedChanged(bool v)
    {
        _collapsed = v;
        try { await Store.SetAsync("dmspro_sidebar_collapsed", v); } catch { }
    }

    private Task ToggleCollapse() => OnCollapsedChanged(!_collapsed);

    private async Task LoadReportLinksAsync()
    {
        try
        {
            var cfg = new DataSourceConfig
            {
                Source     = "DMSViewReportTemplate",
                SourceType = DataSourceType.View,
                PageSize   = 1000
            };
            var rows = await Repo.FetchAllAsync(cfg);

            var nameKeys   = new[] { "ReportName","Name","Title","DisplayName","RPT_NAME","REPORT_NAME" };
            var sourceKeys = new[] { "SourceName","Source","ObjectName","SPName","ProcName","ViewName","TableName","RPT_SOURCE" };
            var typeKeys   = new[] { "SourceType","Type","ObjectType","RPT_TYPE","SourceKind" };

            var drafts = new List<(string Name, string Source, string TypeStr)>();
            foreach (var row in rows)
            {
                var name   = Pick(row, nameKeys);
                var source = Pick(row, sourceKeys);
                if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(source)) continue;

                var typeStr = Pick(row, typeKeys)?.Trim().ToLower() switch
                {
                    "sp" or "storedprocedure" or "procedure" or "proc" => "SP",
                    "view" or "vw"                                      => "View",
                    "table" or "tbl"                                    => "Table",
                    _                                                   => InferType(source)
                };
                drafts.Add((name, source, typeStr));
            }

            // M1-FIX: batch 5 SP moi lan + timeout 20s tong the, tranh connection pool starvation
            var spDrafts = drafts.Where(d => d.TypeStr == "SP").ToList();
            var spTasks  = new Dictionary<string, Task<IReadOnlyList<BlazorReporting.Data.SpParameter>>>();
            using var cts20 = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            foreach (var batch in spDrafts.Chunk(5))
            {
                var batchTasks = batch.Select(d => (d.Source, Task: Repo.GetSpParametersAsync(d.Source)));
                try { await Task.WhenAll(batchTasks.Select(x => x.Task)); } catch { /* ignore batch timeout */ }
                foreach (var (src, task) in batchTasks) spTasks[src] = task;
                if (cts20.IsCancellationRequested) break;
            }

            var links = drafts.Select(d =>
            {
                var url = $"/report?Source={d.Source}&Type={d.TypeStr}";

                IReadOnlyList<SpParamInfo>? spParams = null;
                if (d.TypeStr == "SP" && spTasks.TryGetValue(d.Source, out var t) && t.IsCompletedSuccessfully)
                {
                    spParams = t.Result
                        .Select(p => new SpParamInfo(p.Name, p.TypeName, !p.HasDefault))
                        .ToList();
                }

                return new ChatNavLink(d.Name, url, spParams);
            }).ToList();

            _reportLinks = links;
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private static string? Pick(Dictionary<string, object?> row, string[] keys)
    {
        foreach (var k in keys)
            if (row.TryGetValue(k, out var v) && v != null)
                return v.ToString();
        return null;
    }

    private static string InferType(string source)
    {
        var s = source.ToLower();
        if (s.StartsWith("sp_") || s.StartsWith("usp_") || s.StartsWith("proc_")) return "SP";
        if (s.StartsWith("vw_") || s.StartsWith("view_") || s.StartsWith("v_"))   return "View";
        return "View";
    }

    private async Task LogoutAsync()
    {
        Audit.Log(Auth.UserName, AuditLogService.LOGOUT, fullName: Auth.FullName, role: Auth.Role); // S3
        try { await Store.DeleteAsync("dmspro_auth"); } catch { }
        Auth.Logout();
        Nav.NavigateTo("/");
    }
}
